  "properties": {
    "version": {
      "const": "0.6.0"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "text"
        ],
        "properties": {
          "id": {
            "enum": [
              "Q1",
              "Q2"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      },
      "minItems": 2,
      "maxItems": 2
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "independent_validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
