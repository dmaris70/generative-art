                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "effective_status": {
                    "enum": [
                      "directly_supported",
                      "plausible_inference",
                      "partly_supported",
                      "unsupported",
                      "requires_external_evidence"
                    ]
                  },
                  "disposition": {
                    "enum": [
