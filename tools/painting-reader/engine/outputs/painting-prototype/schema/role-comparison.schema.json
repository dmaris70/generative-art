{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "questions",
    "model",
    "method_sources",
    "limits",
    "artifact_kind",
    "pair_id",
    "binding",
    "works",
    "evidence",
    "comparisons",
    "order_control",
    "duplicate_control"
