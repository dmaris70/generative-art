        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "independent_validation": {
          "const": false
        }
      }
    },
    "method_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
