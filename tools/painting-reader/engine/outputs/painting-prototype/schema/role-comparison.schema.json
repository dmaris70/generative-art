                    "properties": {
                      "case_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "directly_supported",
                          "plausible_inference",
                          "partly_supported",
                          "unsupported",
                          "requires_external_evidence"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing_evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "visual_assessment": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "case_id",
                          "status",
                          "reason",
                          "missing_evidence"
                        ],
                        "properties": {
                          "case_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "status": {
                            "enum": [
                              "directly_supported",
                              "plausible_inference",
                              "partly_supported",
                              "unsupported",
                              "requires_external_evidence"
                            ]
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          },
                          "missing_evidence": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "deterministic_flags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
