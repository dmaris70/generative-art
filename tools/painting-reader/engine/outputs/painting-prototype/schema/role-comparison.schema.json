          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "artifact_kind": {
      "const": "role_comparison"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^met-[0-9]+--met-[0-9]+$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha256"
