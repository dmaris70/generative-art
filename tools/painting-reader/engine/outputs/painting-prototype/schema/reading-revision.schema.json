{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.9.0"
    },
    "artifact_kind": {
      "const": "reading_revision"
    },
    "work_id": {
      "type": "string",
      "pattern": "^met-[0-9]+$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "generated_at": {
      "type": "string"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "feedback_revision": {
          "type": "integer",
          "minimum": 1
        },
        "feedback_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parent_revision_id": {
          "type": "string",
          "pattern": "^(baseline|[a-f0-9]{32})$"
        },
        "parent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "code_sha256",
        "base_sha256",
        "image_sha256",
        "feedback_revision",
        "feedback_sha256",
        "parent_revision_id",
        "parent_sha256"
      ]
    },
    "correction": {
      "type": "object"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "text"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object"
      }
    },
    "claim_audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "checked_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "generation_context": {
      "type": "object"
    },
    "previous_paragraph": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "type": "object"
    },
    "draft_audit": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "display": {
      "type": "object",
      "required": [
        "paragraph",
        "eligible_for_display",
        "flags",
        "assessments",
        "scope",
        "origin"
      ],
      "properties": {
        "paragraph": {
          "type": "string",
          "minLength": 1
        },
        "eligible_for_display": {
          "type": "boolean"
        },
        "flags": {
          "type": "array"
        },
        "assessments": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3
        },
        "scope": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "native_revision_draft",
            "controlled_evidence_and_report_rendering"
          ]
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "required": [
        "previous_paragraph",
        "revised_paragraph",
        "retained_or_qualified",
        "pending"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "independent_validation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "independent_validation": {
          "const": false
        }
      }
    },
    "native_display": {
      "type": "object"
    },
    "constructed_revision": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "artifact_kind",
    "work_id",
    "revision_id",
    "generated_at",
    "binding",
    "correction",
    "segments",
    "evidence",
    "claim_audit",
    "checked_segments",
    "generation_context",
    "previous_paragraph",
    "draft",
    "draft_audit",
    "display",
    "changes",
    "model",
    "native_display",
    "constructed_revision"
  ]
}
