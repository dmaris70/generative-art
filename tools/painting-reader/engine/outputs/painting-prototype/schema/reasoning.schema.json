{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Painting reasoning and controlled comparisons 0.4",
 "type":"object","additionalProperties":false,
 "required":["version","work_id","generated_at","binding","model","views","evidence","explanations","clauses","evidence_tests","visual_comparisons","reanalysis","open_question","limits"],
 "properties":{
  "version":{"const":"0.4.0"},"work_id":{"type":"string","pattern":"^met-[0-9]+$"},"generated_at":{"type":"string"},
  "binding":{"type":"object","additionalProperties":false,"required":["base_sha256","review_revision","image_sha256","code_sha256"],"properties":{
   "base_sha256":{"$ref":"#/$defs/hash"},"review_revision":{"type":"integer","minimum":0},"image_sha256":{"$ref":"#/$defs/hash"},"code_sha256":{"$ref":"#/$defs/hash"}}},
  "model":{"type":"object","additionalProperties":false,"required":["id","revision","runtime","independent_validation"],"properties":{
   "id":{"type":"string"},"revision":{"type":"string"},"runtime":{"type":"object"},"independent_validation":{"const":false}}},
  "views":{"type":"array","minItems":1,"items":{"type":"object","required":["id","file","scale","pixel_sha256","file_sha256","size","bbox_source","upsampled"],"properties":{
   "id":{"type":"string"},"file":{"type":"string","pattern":"^images/[a-zA-Z0-9_-]+\\.png$"},"scale":{"enum":["whole","group","detail"]},
   "pixel_sha256":{"$ref":"#/$defs/hash"},"file_sha256":{"$ref":"#/$defs/hash"},"size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}},
   "bbox_source":{"$ref":"#/$defs/box"},"upsampled":{"const":false},"native_frame_pixels":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"integer","minimum":0}},
   "available_crop_size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}},"display_size":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer","minimum":1}}},"additionalProperties":false}},
  "evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,
   "required":["id","kind","scale","statement","region_ids","view_ids","source_claim_id","status","limitations"],"properties":{
    "id":{"type":"string"},"kind":{"enum":["measurement","visual_description","reviewer_assertion"]},"scale":{"enum":["whole","group","detail"]},"statement":{"$ref":"#/$defs/text"},"facts":{"type":"object"},
    "region_ids":{"$ref":"#/$defs/ids"},"view_ids":{"$ref":"#/$defs/ids"},"source_claim_id":{"type":["string","null"]},
    "status":{"enum":["measured","model_proposal_unreviewed","reviewer_attributed","requires_external_evidence","needs_review","rejected"]},"limitations":{"$ref":"#/$defs/strings"}}}},
  "explanations":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","title","clause_ids"],"properties":{
   "id":{"type":"string"},"title":{"$ref":"#/$defs/text"},"clause_ids":{"type":"array","minItems":2,"maxItems":3,"uniqueItems":true,"items":{"type":"string"}}}}},
  "clauses":{"type":"array","minItems":2,"maxItems":9,"items":{"type":"object","additionalProperties":false,
   "required":["id","statement","kind","evidence_ids","reasoning","alternative","challenge","model_assessment","support_status","publication_status","flags","independent_review"],"properties":{
    "id":{"type":"string"},"statement":{"$ref":"#/$defs/text"},"kind":{"enum":["visual_description","interpretive_hypothesis","viewer_response_hypothesis"]},"evidence_ids":{"$ref":"#/$defs/nonempty_ids"},
    "reasoning":{"$ref":"#/$defs/text"},"alternative":{"$ref":"#/$defs/text"},"challenge":{"$ref":"#/$defs/text"},"model_assessment":{"$ref":"#/$defs/assessment"},
    "support_status":{"$ref":"#/$defs/support"},"publication_status":{"enum":["withheld","qualified","proposed"]},"flags":{"$ref":"#/$defs/strings"},"independent_review":{"const":"pending"}}}},
  "evidence_tests":{"type":"object","additionalProperties":false,"required":["plan","assessments","empty_evidence_violations","limits"],"properties":{
   "plan":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["case_id","clause_id","condition","available_evidence_ids","removed_evidence_id","control_available"],"properties":{
    "case_id":{"type":"string"},"clause_id":{"type":"string"},"condition":{"enum":["cited_plus_distractor","remove_uncited_control","remove_cited","empty_evidence"]},"available_evidence_ids":{"$ref":"#/$defs/ids"},"removed_evidence_id":{"type":["string","null"]},"control_available":{"type":"boolean"}}}},
   "assessments":{"type":"array","items":{"$ref":"#/$defs/assessment"}},"empty_evidence_violations":{"$ref":"#/$defs/ids"},"limits":{"$ref":"#/$defs/text"}}},
  "visual_comparisons":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","view_id","metrics","assessments"],"properties":{
   "id":{"enum":["original","value_only","resolution_256"]},"view_id":{"type":"string"},"metrics":{"type":"object"},"assessments":{"type":"array","items":{"$ref":"#/$defs/assessment"}}}}},
  "reanalysis":{"type":"object","additionalProperties":false,"required":["changed_review_entities","description_changes","inspected_regions","cache_hits","reviewer_text_preserved","clause_feedback","clause_feedback_revision","clause_changes","comparison_limit"],"properties":{
   "clause_feedback":{"type":"array","items":{"type":"object"}},"clause_feedback_revision":{"type":"integer","minimum":0},
   "bounded_revision":{"type":"object","required":["attempted","trigger_flags","remaining_numeric_flags"],"properties":{"attempted":{"type":"boolean"},"trigger_flags":{"type":"array"},"remaining_numeric_flags":{"type":"array"}},"additionalProperties":false},
   "clause_changes":{"type":"array","items":{"type":"object","required":["position","before","after"],"properties":{"position":{"type":"string"},"before":{"type":["string","null"]},"after":{"type":"string"}},"additionalProperties":false}},"comparison_limit":{"type":"string"},
   "changed_review_entities":{"$ref":"#/$defs/ids"},"description_changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim_id","before","after","assessment"],"properties":{
    "claim_id":{"type":"string"},"before":{"$ref":"#/$defs/text"},"after":{"$ref":"#/$defs/text"},"assessment":{"type":"string"}}}},
   "inspected_regions":{"$ref":"#/$defs/ids"},"cache_hits":{"type":"integer","minimum":0},"reviewer_text_preserved":{"$ref":"#/$defs/ids"}}},
  "open_question":{"$ref":"#/$defs/text"},"limits":{"$ref":"#/$defs/strings"}
 },
 "$defs":{
  "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"text":{"type":"string","minLength":1},
  "ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"nonempty_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
  "strings":{"type":"array","items":{"type":"string"}},"box":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}},
  "support":{"enum":["directly_supported","plausible_inference","partly_supported","unsupported","requires_external_evidence"]},
  "assessment":{"type":"object","additionalProperties":false,"required":["case_id","assessment","reason"],"properties":{
   "case_id":{"type":"string"},"assessment":{"$ref":"#/$defs/support"},"reason":{"$ref":"#/$defs/text"}}}
 }
}
