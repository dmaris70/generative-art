{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifact_kind",
    "work_id",
    "generated_at",
    "binding",
    "model",
    "evidence",
    "clauses",
    "source_explanations",
    "source_locator",
    "limits"
  ],
  "properties": {
    "version": {
      "const": "0.5.0"
    },
    "artifact_kind": {
      "const": "clause_audit"
    },
    "work_id": {
      "type": "string",
      "pattern": "^met-[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_sha256",
        "image_sha256",
        "code_sha256",
        "source_review_revision"
      ],
      "properties": {
        "reasoning_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_review_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "independent_validation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "independent_validation": {
          "const": false
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "measurement",
              "visual_description",
              "reviewer_assertion"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "legacy_status",
          "statement",
          "bridge",
          "failure_categories",
          "recommendation",
          "bridge_proposal",
          "alternative",
          "challenge"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "legacy_status": {
            "enum": [
              "proposed",
              "qualified",
              "withheld"
            ]
          },
          "statement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "declared_kind",
              "effective_kind",
              "evidence_ids",
              "evidence_assessment",
              "visual_assessment",
              "deterministic_flags",
              "effective_status",
              "disposition",
              "independent_review",
              "scope"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "declared_kind": {
                "type": "string",
                "minLength": 1
              },
              "effective_kind": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "evidence_assessment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "status",
                  "reason",
                  "missing_evidence"
                ],
                "properties": {
                  "case_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "directly_supported",
                      "plausible_inference",
                      "partly_supported",
                      "unsupported",
                      "requires_external_evidence"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "missing_evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "visual_assessment": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "case_id",
                      "status",
                      "reason",
                      "missing_evidence"
                    ],
                    "properties": {
                      "case_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "directly_supported",
                          "plausible_inference",
                          "partly_supported",
                          "unsupported",
                          "requires_external_evidence"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing_evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deterministic_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "effective_status": {
                "enum": [
                  "directly_supported",
                  "plausible_inference",
                  "partly_supported",
                  "unsupported",
                  "requires_external_evidence"
                ]
              },
              "disposition": {
                "enum": [
                  "proposed",
                  "qualified",
                  "withheld"
                ]
              },
              "independent_review": {
                "const": "pending"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "bridge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "declared_kind",
              "effective_kind",
              "evidence_ids",
              "evidence_assessment",
              "visual_assessment",
              "deterministic_flags",
              "effective_status",
              "disposition",
              "independent_review",
              "scope"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "declared_kind": {
                "type": "string",
                "minLength": 1
              },
              "effective_kind": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "evidence_assessment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "status",
                  "reason",
                  "missing_evidence"
                ],
                "properties": {
                  "case_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "directly_supported",
                      "plausible_inference",
                      "partly_supported",
                      "unsupported",
                      "requires_external_evidence"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "missing_evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "visual_assessment": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "case_id",
                      "status",
                      "reason",
                      "missing_evidence"
                    ],
                    "properties": {
                      "case_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "directly_supported",
                          "plausible_inference",
                          "partly_supported",
                          "unsupported",
                          "requires_external_evidence"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "missing_evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "deterministic_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "effective_status": {
                "enum": [
                  "directly_supported",
                  "plausible_inference",
                  "partly_supported",
                  "unsupported",
                  "requires_external_evidence"
                ]
              },
              "disposition": {
                "enum": [
                  "proposed",
                  "qualified",
                  "withheld"
                ]
              },
              "independent_review": {
                "const": "pending"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "failure_categories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "bridge_proposal": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "raw",
                  "assessment",
                  "status"
                ],
                "properties": {
                  "raw": {
                    "type": "object",
                    "required": [
                      "case_id",
                      "action",
                      "bridge",
                      "evidence_ids",
                      "reason",
                      "challenge"
                    ]
                  },
                  "assessment": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text",
                          "declared_kind",
                          "effective_kind",
                          "evidence_ids",
                          "evidence_assessment",
                          "visual_assessment",
                          "deterministic_flags",
                          "effective_status",
                          "disposition",
                          "independent_review",
                          "scope"
                        ],
                        "properties": {
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "declared_kind": {
                            "type": "string",
                            "minLength": 1
                          },
                          "effective_kind": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_ids": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                              "type": "string"
                            }
                          },
                          "evidence_assessment": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "case_id",
                              "status",
                              "reason",
                              "missing_evidence"
                            ],
                            "properties": {
                              "case_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "status": {
                                "enum": [
                                  "directly_supported",
                                  "plausible_inference",
                                  "partly_supported",
                                  "unsupported",
                                  "requires_external_evidence"
                                ]
                              },
                              "reason": {
                                "type": "string",
                                "minLength": 1
                              },
                              "missing_evidence": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "visual_assessment": {
                            "anyOf": [
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "case_id",
                                  "status",
                                  "reason",
                                  "missing_evidence"
                                ],
                                "properties": {
                                  "case_id": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "status": {
                                    "enum": [
                                      "directly_supported",
                                      "plausible_inference",
                                      "partly_supported",
                                      "unsupported",
                                      "requires_external_evidence"
                                    ]
                                  },
                                  "reason": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "missing_evidence": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "deterministic_flags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "effective_status": {
                            "enum": [
                              "directly_supported",
                              "plausible_inference",
                              "partly_supported",
                              "unsupported",
                              "requires_external_evidence"
                            ]
                          },
                          "disposition": {
                            "enum": [
                              "proposed",
                              "qualified",
                              "withheld"
                            ]
                          },
                          "independent_review": {
                            "const": "pending"
                          },
                          "scope": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "enum": [
                      "awaiting_check",
                      "checked_model_proposal",
                      "abstained",
                      "invalid_proposal"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "challenge": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "clause_ids"
        ]
      }
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate statement and reasoning support, v0.5"
}
