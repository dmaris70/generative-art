                </div>

                <div class="control-group">
                    <label>Composition (focal spine)</label>
                    <div class="slider-container">
                        <input type="range" id="composition" min="0" max="1.2" step="0.02" value="0.6" oninput="updateParam('composition', this.value)">
                        <span class="value-display" id="composition-value">0.60</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Pressure Contrast</label>
                    <div class="slider-container">
                        <input type="range" id="contrast" min="0.5" max="2.5" step="0.05" value="1.4" oninput="updateParam('contrast', this.value)">
                        <span class="value-display" id="contrast-value">1.40</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Pressure Patches</label>
                    <div class="slider-container">
                        <input type="range" id="patchiness" min="0" max="1" step="0.05" value="0.7" oninput="updateParam('patchiness', this.value)">
                        <span class="value-display" id="patchiness-value">0.70</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Banding</label>
                    <div class="slider-container">
                        <input type="range" id="band" min="0" max="0.6" step="0.02" value="0.3" oninput="updateParam('band', this.value)">
                        <span class="value-display" id="band-value">0.30</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Partial Lines</label>
                    <div class="slider-container">
                        <input type="range" id="partial" min="0" max="0.5" step="0.02" value="0.2" oninput="updateParam('partial', this.value)">
                        <span class="value-display" id="partial-value">0.20</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Line Omission</label>
                    <div class="slider-container">
                        <input type="range" id="omit" min="0" max="1" step="0.01" value="0.25" oninput="updateParam('omit', this.value)">
                        <span class="value-display" id="omit-value">0.12</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Fatigue (κ)</label>
                    <div class="slider-container">
                        <input type="range" id="fatigue" min="0" max="1" step="0.05" value="0.45" oninput="updateParam('fatigue', this.value)">
                        <span class="value-display" id="fatigue-value">0.45</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Edge Raggedness</label>
                    <div class="slider-container">
                        <input type="range" id="ragged" min="0" max="1" step="0.05" value="0.6" oninput="updateParam('ragged', this.value)">
                        <span class="value-display" id="ragged-value">0.60</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Ink Grain</label>
                    <div class="slider-container">
                        <input type="range" id="inkGrain" min="0" max="1" step="0.02" value="0.5" oninput="updateParam('inkGrain', this.value)">
                        <span class="value-display" id="inkGrain-value">0.50</span>
