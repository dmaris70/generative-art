                <div class="control-group">
                    <label>Stroke Density</label>
                    <div class="slider-container">
                        <input type="range" id="density" min="0.4" max="1" step="0.02" value="0.9" oninput="updateParam('density', this.value)">
                        <span class="value-display" id="density-value">0.90</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Slant</label>
                    <div class="slider-container">
                        <input type="range" id="slant" min="-0.25" max="0.25" step="0.01" value="0.05" oninput="updateParam('slant', this.value)">
                        <span class="value-display" id="slant-value">0.05</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Hand Tremor</label>
                    <div class="slider-container">
                        <input type="range" id="tremor" min="0" max="0.06" step="0.002" value="0.025" oninput="updateParam('tremor', this.value)">
                        <span class="value-display" id="tremor-value">0.025</span>
                    </div>
                </div>

                <div class="control-group">
                    <label>Ligature (connected writing)</label>
                    <div class="slider-container">
                        <input type="range" id="ligature" min="0" max="1" step="0.02" value="0.5" oninput="updateParam('ligature', this.value)">
                        <span class="value-display" id="ligature-value">0.50</span>
