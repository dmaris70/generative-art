                    <label>Paper Texture</label>
                    <div class="slider-container">
                        <input type="range" id="paperTex" min="0" max="1" step="0.02" value="0.6" oninput="updateParam('paperTex', this.value)">
                        <span class="value-display" id="paperTex-value">0.60</span>
                    </div>
                </div>
            </div>

            <!-- Actions Section -->
            <div class="control-section">
                <h3>Actions</h3>
                <div class="button-row">
                    <button class="button" onclick="regenerate()">Regenerate</button>
                    <button class="button" onclick="resetParameters()">Reset</button>
                </div>
                <button class="button tertiary" onclick="download4K()">Save 4K PNG</button>
                <button class="button secondary" onclick="downloadSVG()" style="margin-top:8px">Save SVG (pen plotter)</button>
            </div>
        </div>

        <!-- Main Canvas Area -->
        <div class="canvas-area">
            <div id="canvas-container">
                <div class="loading">Sitting down to write...</div>
            </div>
        </div>
    </div>

    <script>
        // ═══════════════════════════════════════════════════════════════════════
        // INK LEDGERS — seeded asemic sheets
        //
        // One loop with weather: horizontal registers filled with short sheared
        // strokes; a layered-noise pressure field governs darkness, length,
        // thickness, and skips; a 1D row field adds cloth-like banding; columns
        // share a slow undulation so edges arrive wavy. Ink is accumulation:
        // each stroke is several offset low-alpha hairlines. The seed designs
        // everything — medium, weave, weather, margins, paper. Deterministic
        // at any resolution: geometry lives in normalized units; per-stroke
        // randomness comes from a dedicated seeded RNG. Default seed: 62.
        // ═══════════════════════════════════════════════════════════════════════

        const BASE_W = 1200;
        const ASPECT = 1.345;             // proportions of the sheet
        const MAX_STROKES = 260000;       // hard budget, spacing widens beyond it

        // ── Media: inks + the full graphite grading scale ────────────────────
        // Pencil physics from hardness h ∈ [-9 (9H) … +9 (9B)], u = (h+9)/18:
        //   H series (more clay): light value, low alpha, fine line, crisp,
        //     flickers on the paper tooth, never smudges.
        //   HB / F: the standard writing pencil — balanced.
        //   B series (more graphite): dark, broad, blendable — smudge halo
        //     and mid-stroke pressure pooling.
        const INKS = [
            { name: 'India ink', rgb: [26, 25, 23], alpha: 0.62, weight: 1.05, subs: 3,
              cap: 'square', scatter: 0.9, halo: 0, grain: 0.08, soft: 0.5 },
            { name: 'Sepia ink', rgb: [74, 53, 32], alpha: 0.55, weight: 0.95, subs: 3,
              cap: 'square', scatter: 0.9, halo: 0, grain: 0.08, soft: 0.5 }
        ];
        const GRADE_DEFS = [['9H',-9],['6H',-6],['4H',-4],['2H',-2],['H',-1],['F',-0.5],
                            ['HB',0],['B',1],['2B',2],['4B',4],['6B',6],['9B',9]];
        const PENCILS = GRADE_DEFS.map(function(gd) {
            const u = (gd[1] + 9) / 18;
            const v = Math.round(132 - 106 * u);
            return {
                name: gd[0], rgb: [v, v, v + 3],
                alpha: 0.16 + 0.55 * u,            // clay → light, graphite → dark
                weight: 0.55 + 0.85 * u,           // hard → fine point, soft → broad
                subs: u < 0.35 ? 2 : (u < 0.65 ? 3 : 4),
                cap: 'round',
                scatter: 0.5 + 1.1 * u,            // soft lead spreads
                halo: Math.max(0, u - 0.55) * 0.45, // B-series smudge
                grain: Math.max(0, 0.5 - u) * 0.9,  // H-series tooth flicker
                soft: u
            };
        });
        // Thin brush pens — dry, frayed, streaky. Rendered procedurally as
        // broken bristle streaks with tapered/frayed ends and grain skips,
        // capturing the character of a nearly-dry thin brush.
        const BRUSHES = [
            { name: 'Thin brush', rgb: [22, 20, 18], alpha: 0.72, weight: 1.05, subs: 4,
              cap: 'round', scatter: 0.7, halo: 0, grain: 0.35, soft: 0.4, brush: 1, dry: 0.22, fray: 0.65 },
            { name: 'Dry brush',  rgb: [24, 22, 20], alpha: 0.64, weight: 0.95, subs: 5,
              cap: 'round', scatter: 0.95, halo: 0, grain: 0.6, soft: 0.3, brush: 1, dry: 0.5, fray: 0.9 }
        ];
        // Oil brushes — broad, loaded bodies raked into parallel bristle
        // grooves, some scumbled lighter, wetter than the dry brush (few
        // skips). Rendered as several offset tapered bristle-blades per mark.
        const OILS = [
            { name: 'Oil brush',  rgb: [28, 24, 20], alpha: 0.42, weight: 1.5, subs: 7,
              cap: 'round', scatter: 0.4, halo: 0, grain: 0.22, soft: 0.6, oil: 1, body: 1.7 },
            { name: 'Oil, loaded', rgb: [24, 21, 17], alpha: 0.52, weight: 1.9, subs: 9,
              cap: 'round', scatter: 0.35, halo: 0, grain: 0.14, soft: 0.78, oil: 1, body: 2.1 }
        ];
        // Architect pens — crisp, hard, near-uniform technical drafting lines
        // with the draughtsman's signature overshoot (marks cross slightly
        // past their ends). Minimal taper, minimal grain, precise.
        const ARCHITECTS = [
            { name: 'Architect pen',    rgb: [20, 22, 28], alpha: 0.72, weight: 0.85, subs: 2,
              cap: 'round', scatter: 0.22, halo: 0, grain: 0.08, soft: 0.3, arch: 1, overshoot: 0.13 },
            { name: 'Architect pencil', rgb: [60, 60, 64], alpha: 0.5, weight: 0.8, subs: 2,
              cap: 'round', scatter: 0.28, halo: 0, grain: 0.34, soft: 0.3, arch: 1, overshoot: 0.08 }
        ];
        // Watercolour washes — soft, translucent, granular, with the tell-tale
        // darker pigment rim where the wet edge settles. Muted pigments (payne's
        // grey / sepia) so they sit in the family. A faint bleed halo softens
        // each mark; overlap builds tone the way layered washes do.
        const WATERS = [
            { name: 'Watercolour',      rgb: [42, 46, 68], alpha: 0.26, weight: 1.9, subs: 5,
              cap: 'round', scatter: 0.85, halo: 0, grain: 0.5, soft: 0.7, water: 1, bleed: 1.5 },
            { name: 'Watercolour, wet', rgb: [60, 44, 40], alpha: 0.2, weight: 2.4, subs: 6,
              cap: 'round', scatter: 1.05, halo: 0, grain: 0.4, soft: 0.85, water: 1, bleed: 2.1 }
        ];
        // Painted brushes — solid, opaque painterly strokes (acrylic/gouache):
        // clean bodies with ragged paint edges and a faint internal drag
        // streak. Opaque, unlike the watercolour wash; smoother than the raked
        // oil. The all-purpose loaded brush.
        const PAINTED = [
            { name: 'Painted brush', rgb: [30, 28, 26], alpha: 0.6, weight: 1.55, subs: 3,
              cap: 'round', scatter: 0.5, halo: 0, grain: 0.18, soft: 0.55, paint: 1, edge: 0.38 },
            { name: 'Gouache',       rgb: [36, 34, 30], alpha: 0.8, weight: 1.45, subs: 3,
              cap: 'round', scatter: 0.4, halo: 0, grain: 0.1, soft: 0.5, paint: 1, edge: 0.24 }
        ];
        // Claw / rake brushes — several parallel scratch tracks with gaps
        // between them, as if a claw or rake were dragged across the surface.
        // Each tine is a thin, sharp, scratchy tapered line; the tines stay
        // separate (unlike the raked oil, whose bristles fuse into a body).
        const CLAWS = [
            { name: 'Claw', rgb: [24, 22, 20], alpha: 0.64, weight: 1.4, subs: 4,
              cap: 'round', scatter: 0.5, halo: 0, grain: 0.35, soft: 0.4, claw: 1, spreadW: 1.7 },
            { name: 'Rake', rgb: [26, 24, 22], alpha: 0.56, weight: 1.8, subs: 6,
              cap: 'round', scatter: 0.6, halo: 0, grain: 0.3, soft: 0.4, claw: 1, spreadW: 2.3 }
        ];
        // Camisado paint — loose, gestural, wet loaded strokes with the
        // expressive accidents of a full brush: blotchy opaque bodies, the
        // occasional drip trailing off a foot, and flecks of spatter.
        const CAMISADO = [
            { name: 'Camisado paint',  rgb: [22, 20, 18], alpha: 0.72, weight: 1.9, subs: 3,
              cap: 'round', scatter: 0.55, halo: 0, grain: 0.22, soft: 0.6, cami: 1, drip: 0.13, spatter: 0.16 },
            { name: 'Camisado, loaded', rgb: [20, 18, 16], alpha: 0.84, weight: 2.3, subs: 4,
              cap: 'round', scatter: 0.6, halo: 0, grain: 0.14, soft: 0.72, cami: 1, drip: 0.2, spatter: 0.26 }
        ];
        // Impasto — thick paint standing off the surface. Faked in 3D with a
        // lit ridge: each mark gets a lifted highlight on the light side and a
        // cast shadow on the dark side of a raised body, so it reads sculptural.
        const IMPASTO = [
            { name: 'Impasto', rgb: [34, 31, 27], alpha: 0.86, weight: 2.1, subs: 4,
              cap: 'round', scatter: 0.45, halo: 0, grain: 0.14, soft: 0.7, impasto: 1, relief: 1.0 },
            { name: 'Impasto, heavy', rgb: [30, 27, 23], alpha: 0.9, weight: 2.7, subs: 5,
              cap: 'round', scatter: 0.4, halo: 0, grain: 0.1, soft: 0.8, impasto: 1, relief: 1.5 }
        ];
        const MEDIA = INKS.concat(PENCILS).concat(BRUSHES).concat(OILS)
                          .concat(ARCHITECTS).concat(WATERS).concat(PAINTED).concat(CLAWS)
                          .concat(CAMISADO).concat(IMPASTO);
        const MIXED_MEDIUM = MEDIA.length;   // sentinel: per-stroke random grade
        const BRUSH0 = INKS.length + PENCILS.length;                                  // first brush (14)
        const OIL0   = INKS.length + PENCILS.length + BRUSHES.length;                 // first oil (16)
        const ARCH0  = INKS.length + PENCILS.length + BRUSHES.length + OILS.length;   // first architect (18)
        const WATER0 = ARCH0 + ARCHITECTS.length;                                     // first watercolour (20)
        const PAINT0 = WATER0 + WATERS.length;                                        // first painted (22)
        const CLAW0  = PAINT0 + PAINTED.length;                                       // first claw (24)
        const CAMI0  = CLAW0 + CLAWS.length;                                          // first camisado (26)
        const IMP0   = CAMI0 + CAMISADO.length;                                       // first impasto (28)

        function hexRgb(hex) {
            return [parseInt(hex.slice(1,3),16), parseInt(hex.slice(3,5),16), parseInt(hex.slice(5,7),16)];
        }
        function mixRgb(a, b, t) {
            return [a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t, a[2]+(b[2]-a[2])*t];
        }

        // User-facing design state (all seed-drawn, hand-overridable)
        let params = {
            seed: 62,
            medium: 0,
            weightMode: 3,    // 0 fine | 1 medium | 2 heavy | 3 mixed
            rowH: 0.010,      // register height, fraction of sheet width
            density: 0.90,
            slant: 0.05,      // radians
            tremor: 0.025,
            ligature: 0.5,
            composition: 0.6,
            contrast: 1.40,
            patchiness: 0.70,
            band: 0.30,
            ragged: 0.60,
            omit: 0.25,
            partial: 0.20,
            inkGrain: 0.5,
            paperTex: 0.6,
            fatigue: 0.45     // κ — constitutional labour constant (0 = tireless hand)
        };

        // Fatigue ledger v1 — the last render's closing books (published)
        let LAST_LEDGER = { F: 1, kappa: 0, work: 0, rests: 0 };

        // ── INK LEDGER: a finite pen. One load per work; it drains as it
        // draws (µl/m = lineWidth_mm × filmThickness_µm), starves (pales and
        // skips) over its last breaths, and stops dead when dry. Line length
        // is integrated from the real stroke geometry — the same paths a
        // plotter would ink — so metres, survival, and the exact dry stroke
        // are a deterministic function of the seed. `pen` lives outside
        // `state` so generate()/snapshots never touch the fuel gauge.
        let pen = {
            on: false,
            reservoir: 1000,   // µl in one load (1.0 ml)
            lineMm: 0.30,      // nib width — the dominant lever
            filmUm: 6,         // dry ink film thickness (µl/m = lineMm × filmUm)
            sheetCm: 30,       // physical long edge of one sheet
            // live state (persists across a wall)
            left: 1000, managed: false,
            // per-render accounting
            totalM: 0, markN: 0, dryMarkN: -1, dryX: 0, dryRow: 0,
            drySheet: -1, lastScope: 'sheet'
        };
        const penPerM = () => pen.lineMm * pen.filmUm;          // µl per metre
        const penCapM = () => pen.reservoir / penPerM();        // metres one load draws

        // Hidden seed-drawn state
        let state = {
            spacing: 0.0024, slantDrift: 0.12, fieldScale: 3.5,
            mL: 0.065, mT: 0.055, mB: 0.10,
            wobble: 0.35, lenJit: 0.35, paper: '#f1ead9',
            lightProb: 0.3, groundT: 0.85,
            focalX: 0.5, focalY: 0.6, focalRX: 0.3, focalRY: 0.35,
            // Wall-mode plumbing (defaults = single-sheet behaviour)
            fieldOffX: 0, fieldOffY: 0, noiseSeedOverride: null,
            bleedL: null, bleedR: null, inscribe: true, inscribeSeed: null,
            bowAmp: 0.012, edgeAmp: 0.007, rowVar: 0.4,
            dirL: 1, dirR: -1, dirT: 1, dirB: -1,
            blobs: []
        };

        function clampN(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

        function hslToHex(h, s, l) {
            h = (h % 360 + 360) % 360; s = clampN(s,0,100)/100; l = clampN(l,0,100)/100;
            const c = (1 - Math.abs(2*l - 1)) * s;
            const x = c * (1 - Math.abs(((h/60) % 2) - 1));
            const m = l - c/2;
            let r = 0, g = 0, b = 0;
            if (h < 60)       { r = c; g = x; }
            else if (h < 120) { r = x; g = c; }
            else if (h < 180) { g = c; b = x; }
            else if (h < 240) { g = x; b = c; }
            else if (h < 300) { r = x; b = c; }
            else              { r = c; b = x; }
            const to2 = v => Math.round((v + m) * 255).toString(16).padStart(2, '0');
            return '#' + to2(r) + to2(g) + to2(b);
        }

        // Dedicated per-render RNG so stroke jitter is identical at any scale
        function mulberry32(a) {
            return function() {
                a |= 0; a = a + 0x6D2B79F5 | 0;
                let t = Math.imul(a ^ a >>> 15, 1 | a);
                t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
                return ((t ^ t >>> 14) >>> 0) / 4294967296;
            };
        }

        // ── The seed designs the sheet ───────────────────────────────────────
        // Design draws use a hashed mulberry32 stream: p5's LCG yields
        // correlated first values for consecutive seeds, which made nearby
        // seeds pick the same medium and slant. Hashing decorrelates them.
        function generate() {
            noiseSeed(params.seed);
            const rd = mulberry32((Math.imul(params.seed, 2654435761) ^ 0x9E3779B9) >>> 0);

            // Medium: pencils, ink, brush, oil, architect, watercolour, paint, mixed
            const mr = rd();
            params.medium = mr < 0.07 ? 0
                          : mr < 0.12 ? 1
                          : mr < 0.21 ? BRUSH0 + Math.floor(rd() * BRUSHES.length)
                          : mr < 0.30 ? OIL0 + Math.floor(rd() * OILS.length)
                          : mr < 0.39 ? ARCH0 + Math.floor(rd() * ARCHITECTS.length)
                          : mr < 0.48 ? WATER0 + Math.floor(rd() * WATERS.length)
                          : mr < 0.54 ? PAINT0 + Math.floor(rd() * PAINTED.length)
                          : mr < 0.61 ? CLAW0 + Math.floor(rd() * CLAWS.length)
                          : mr < 0.69 ? CAMI0 + Math.floor(rd() * CAMISADO.length)
                          : mr < 0.77 ? IMP0 + Math.floor(rd() * IMPASTO.length)
                          : mr < 0.89 ? 2 + Math.floor(rd() * PENCILS.length)
                          : MIXED_MEDIUM;
            params.weightMode = Math.floor(rd() * 4);
            params.tremor   = 0.012 + rd() * 0.028;
            params.ligature = 0.30 + rd() * 0.55;   // how often the pen stays down
            params.rowH     = 0.012 + rd() * 0.010;
            params.density  = 0.92 + rd() * 0.08;
            // Consistent lean of a hand writing from top-left: every stroke
            // runs top-left to bottom-right.
            params.slant    = 0.05 + rd() * 0.15;
            params.contrast = 0.8 + rd() * 1.4;
            params.patchiness = 0.4 + rd() * 0.6;
            params.band     = 0.05 + rd() * 0.20;
            params.ragged   = 0.30 + rd() * 0.70;
            params.inkGrain = 0.35 + rd() * 0.4;     // ink-grain screen strength
            params.paperTex = 0.45 + rd() * 0.4;     // paper-grain multiply strength
            params.omit     = 0.15 + rd() * 0.25;   // whole-line skips, generous
            state.rowVar    = 0.25 + rd() * 0.40;   // per-line height variation
            params.partial  = 0.12 + rd() * 0.18;   // chance a line is half-written

            // Pressure concentrations: seeded gaussian patches, dark and light,
            // scattered across the sheet — the "random weather systems".
            state.blobs = [];
            const nDark  = 3 + Math.floor(rd() * 5);
            const nLight = 2 + Math.floor(rd() * 4);
            for (let i = 0; i < nDark + nLight; i++) {
                state.blobs.push({
                    x: 0.08 + rd() * 0.84,
                    y: 0.08 + rd() * (ASPECT - 0.18),
                    r: 0.07 + rd() * 0.22,
                    amp: (i < nDark ? 1 : -1) * (0.4 + rd() * 0.5)
                });
            }

            state.spacing    = 0.0005 + rd() * 0.0004;   // packed weave
            state.lightProb  = 0.20 + rd() * 0.25;
            state.groundT    = 0.70 + rd() * 0.30;
            state.slantDrift = 0.05 + rd() * 0.15;
            state.fieldScale = 2 + rd() * 4;
            state.mL         = 0.05 + rd() * 0.04;
            state.mT         = 0.04 + rd() * 0.04;
            state.mB         = 0.08 + rd() * 0.06;
            state.wobble     = 0.2 + rd() * 0.5;
            state.bowAmp     = 0.006 + rd() * 0.016;   // gentle curvature of the block
            state.edgeAmp    = 0.004 + rd() * 0.010;   // wander of the boundary
            state.dirL = rd() < 0.5 ? 1 : -1;
            state.dirR = rd() < 0.5 ? 1 : -1;
            state.dirT = rd() < 0.5 ? 1 : -1;
            state.dirB = rd() < 0.5 ? 1 : -1;
            state.endFrac = 0.20 + rd() * 0.65;   // where the last written line stops
            state.lenJit     = 0.2 + rd() * 0.4;
            state.paper      = hslToHex(44 + rd()*10, 16 + rd()*14, 90 + rd()*4);

            // Compositional spine: one focal zone this sheet builds toward and
            // releases from — the writing's subject. Placed in absolute
            // normalized coords (margins are known here), biased off-centre so
            // the arc has somewhere to travel from. Anisotropic — a little
            // taller than wide, a column of intensifying lines.
            params.composition = 0.4 + rd() * 0.5;
            const dW = 1 - 2 * state.mL, dH = ASPECT - state.mT - state.mB;
            state.focalX  = state.mL + (0.22 + rd() * 0.56) * dW;
            state.focalY  = state.mT + (0.28 + rd() * 0.5) * dH;
            state.focalRX = (0.22 + rd() * 0.18) * dW;
            state.focalRY = (0.20 + rd() * 0.22) * dH;
        }

        // Compositional spine intensity at a point (0 far, 1 at the focus)
        function spineAt(nx, ny) {
            nx += state.fieldOffX; ny += state.fieldOffY;   // wall coords when composing
            const dx = (nx - state.focalX) / state.focalRX;
            const dy = (ny - state.focalY) / state.focalRY;
            return Math.exp(-(dx*dx + dy*dy));
        }

        // Paper grain, built once per seed and multiplied over the finished
        // sheet so every mark adopts the tooth, highlights and shadows of the
        // surface — the "blend with paper texture" move. Mostly light values
        // with fine tooth, gentle mottle, and speckle; kept subtle so Multiply
        // reads as real paper, not a filter.
        let paperTexCache = { key: '', g: null };
        function getPaperTex(seed, W) {
            // Generate near the target resolution so the tooth stays crisp at
            // 4K; a fine two-octave weave + fine speckle reads as real laid
            // paper rather than a coarse upscaled filter.
            const Wt = Math.min(W, 2600), Ht = Math.round(Wt * ASPECT);
            const key = seed + '_' + Wt;
            if (paperTexCache.key === key && paperTexCache.g) return paperTexCache.g;
            if (paperTexCache.g) paperTexCache.g.remove();
            const t = createGraphics(Wt, Ht);
            t.pixelDensity(1);
            t.background(255);
            noiseSeed(seed + 777);
            const pr = mulberry32((Math.imul(seed, 7919) ^ 0x27d4eb2d) >>> 0);
            // Frequencies are tied to a 1400px reference so the paper's grain
            // is the same physical fineness regardless of render size.
            const fs = Wt / 1400;
            t.loadPixels();
            const px = t.pixels;
            for (let y = 0; y < Ht; y++) {
                for (let x = 0; x < Wt; x++) {
                    const xf = x / fs, yf = y / fs;
                    const mottle = (noise(xf * 0.015, yf * 0.015) - 0.5) * 12;
                    const tooth  = (noise(xf * 0.85 + 40, yf * 0.85 + 40) - 0.5) * 12;   // fine weave
                    const tooth2 = (noise(xf * 1.9 + 90, yf * 1.9 + 90) - 0.5) * 6;      // finer weave
                    const spk = (pr() - 0.5) * 9;
                    let v = 250 + mottle + tooth + tooth2 + spk;
                    v = v < 216 ? 216 : (v > 255 ? 255 : v);
                    const idx = 4 * (y * Wt + x);
                    px[idx] = v; px[idx+1] = v; px[idx+2] = v - 2; px[idx+3] = 255;
                }
            }
            t.updatePixels();
            paperTexCache = { key, g: t };
            return t;
        }

        // Ink grain, built once per seed and SCREENED over the finished sheet.
        // Screen lifts only the dark pixels (paper, being light, is untouched),
        // so pure black breaks up into textured pigment with fine density
        // variation — no flat digital black. Values are low with fine noise.
        let grainTexCache = { key: '', g: null };
        function getGrainTex(seed, W) {
            const Wt = Math.min(W, 2600), Ht = Math.round(Wt * ASPECT);
            const key = seed + '_' + Wt;
            if (grainTexCache.key === key && grainTexCache.g) return grainTexCache.g;
            if (grainTexCache.g) grainTexCache.g.remove();
            const t = createGraphics(Wt, Ht);
            t.pixelDensity(1);
            t.background(0);
            noiseSeed(seed + 1313);
            const pr = mulberry32((Math.imul(seed, 2246822519) ^ 0x9e3779b9) >>> 0);
            const fs = Wt / 1400;
            t.loadPixels();
            const px = t.pixels;
            for (let y = 0; y < Ht; y++) {
                for (let x = 0; x < Wt; x++) {
                    const grain = noise((x / fs) * 1.1, (y / fs) * 1.1) * 22;   // finer pigment
                    const spk = (pr() - 0.5) * 30;
                    let v = 20 + grain + spk;
                    v = v < 2 ? 2 : (v > 80 ? 80 : v);
                    const idx = 4 * (y * Wt + x);
                    px[idx] = v; px[idx+1] = v; px[idx+2] = v + 2; px[idx+3] = 255;
                }
            }
            t.updatePixels();
            grainTexCache = { key, g: t };
            return t;
        }

        // Pressure weather: layered noise + seeded gaussian concentrations
        function blobFieldAt(nx, ny) {
            let s = 0;
            for (const b of state.blobs) {
                const dx = nx - b.x, dy = ny - b.y;
                s += b.amp * Math.exp(-(dx*dx + dy*dy) / (b.r * b.r));
            }
            return s;
        }

        function pressureAt(nx, ny, rowIdx) {
            const f = state.fieldScale;
            const wx = nx + state.fieldOffX, wy = ny + state.fieldOffY;  // wall coords when composing
            let v = noise(wx * f, wy * f * ASPECT) * 0.65
                  + noise(wx * f * 3.7 + 9, wy * f * 3.7 * ASPECT + 9) * 0.35;
            v = (v - 0.5) * params.contrast + 0.5;
            v += params.patchiness * blobFieldAt(wx, wy) * 0.6;
            v += params.composition * spineAt(nx, ny) * 0.85;   // darken toward the focus
            v += params.band * (noise(77, rowIdx * 0.35) - 0.5) * 1.6;
            // Floor keeps the sheet inked everywhere; concentrations read as
            // heavier and lighter hand, not as holes in the fabric.
            return 0.22 + 0.78 * clampN(v, 0, 1);
        }

        // ── Master renderer (W = pixel width; all geometry normalized) ───────
        // When `vec` is supplied, collect one plotter centreline per mark
        // instead of drawing filled blades — a pure single-pen vector version
        // (no fill, no alpha; tone comes from mark density, not overdraw).
        // AMEND-031 per-piece homomorphism: material-remaining at a vertical position
        // f in [0,1] (top->bottom = time). window.DUCTUS_DECAY is the record's 32-pt decay
        // curve (E(t) in [0,1]) or null. Returns 1 when absent (render unchanged). The curve
        // is data — read here, never the audio — so the drawing is reproducible from it alone.
        function _ductusDecayAt(f) {
            const C = window.DUCTUS_DECAY;
            if (!C || !C.length) return 1;
            const e = C[Math.max(0, Math.min(C.length - 1, Math.round(f * (C.length - 1))))];
            return 0.08 + 0.92 * Math.max(0, Math.min(1, e));   // E->[0.08,1]: a ghost trace remains where the tape died
        }
        function renderTo(g, W, vec) {
            const VEC = vec || null;
            const H = W * ASPECT;
            // A standalone sheet gets a fresh full pen; a wall keeps one load
            // draining across all its sheets (composeWall sets pen.managed).
            if (!pen.managed) {
                pen.left = pen.reservoir;
                pen.totalM = 0; pen.markN = 0; pen.dryMarkN = -1;
            }
            const baseMed = params.medium === MIXED_MEDIUM ? PENCILS[6] /* HB */ : MEDIA[params.medium];
            const rng = mulberry32(params.seed * 1000 + 7);
            noiseSeed(state.noiseSeedOverride != null ? state.noiseSeedOverride : params.seed);
            // (stable field noise on every render; wall mode shares one seed
            // across all sheets so the weather is continuous through gutters)
            const Ws = W / 1200;

            g.background(state.paper);
            g.noFill();
            g.strokeJoin(ROUND);
            g.strokeCap(baseMed.cap === 'square' ? SQUARE : ROUND);

            // Normalized layout, with a stroke-count budget guard
            const mL = state.mL, mT = state.mT, mB = state.mB;
            const drawW = 1 - 2 * mL;
            const drawH = ASPECT - mT - mB;
            let spacing = state.spacing;

            // Variable line heights: each register draws its own height from
            // a dedicated seeded stream — some lines tall, some tight, the
            // occasional double-height one — stable at any resolution.
            const hRng = mulberry32((Math.imul(params.seed, 92821) ^ 0x1B873593) >>> 0);
            const rowTops = [], rowHs = [];
            let yAcc = 0;
            while (true) {
                const uH = hRng(), uH2 = hRng();
                let h = params.rowH * (1 - state.rowVar * 0.5 + state.rowVar * uH);
                if (state.rowVar > 0 && uH2 < 0.10) h *= 1.6;  // occasional tall line (never in wall meter)
                if (yAcc + h > drawH + 1e-9) break;
                rowTops.push(yAcc); rowHs.push(h); yAcc += h;
            }
            while (rowTops.length < 2) {                   // degenerate guard
                rowTops.push(rowTops.length * params.rowH);
                rowHs.push(params.rowH);
            }
            const rows = rowTops.length;
            let perRow = Math.floor(drawW / spacing);
            if (rows * perRow > MAX_STROKES) {
                spacing *= (rows * perRow) / MAX_STROKES;
                perRow = Math.floor(drawW / spacing);
            }

            const paperRGB = hexRgb(state.paper);
            const wobAmp = state.wobble * params.rowH;
            const colWave = nx => wobAmp * 2 * (noise(nx * 3 + 31, 0.5) - 0.5);

            // Organic boundaries: each side of the block bows gently (a slow
            // arc, direction seed-drawn) and wanders (noise), so no edge of
            // the drawing is a ruled line — like a hand keeping to a field it
            // never measured.
            const bow = t => 4 * t * (1 - t);   // 0 at ends, 1 mid
            const xLeft  = ny => { const t = clampN((ny - mT) / drawH, 0, 1);
                return mL + state.bowAmp * bow(t) * state.dirL
                     + state.edgeAmp * (noise(201, ny * 5) - 0.5) * 2; };
            const xRight = ny => { const t = clampN((ny - mT) / drawH, 0, 1);
                return (1 - mL) + state.bowAmp * bow(t) * state.dirR
                     + state.edgeAmp * (noise(401, ny * 5) - 0.5) * 2; };
            const yTop = nx => { const s = clampN((nx - mL) / drawW, 0, 1);
                return mT + state.bowAmp * bow(s) * state.dirT
                     + state.edgeAmp * (noise(301, nx * 5) - 0.5) * 2; };
            const yBot = nx => { const s = clampN((nx - mL) / drawW, 0, 1);
                return mT + drawH + state.bowAmp * bow(s) * state.dirB
                     + state.edgeAmp * (noise(501, nx * 5) - 0.5) * 2; };
            const mX = params.ragged * 0.012 + 0.003;          // horizontal fade depth
            const mY = params.ragged * params.rowH * 1.2 + 0.004; // vertical fade depth

            // The page is written top-left → right, row by row. The final
            // line stops mid-page: past the stopping point the bottom
            // boundary steps up one register, exposing the unwritten paper.
            const xEndN = mL + drawW * state.endFrac;
            const yBotW = nx => yBot(nx)
                - params.rowH * 2.0 * clampN((nx - xEndN) / 0.015, 0, 1);

            // Line weight mode: fixed factor, or per-stroke mixed
            const WFIX = [0.7, 1.0, 1.45];

            // Randomly omitted lines: some registers are simply never written.
            // Decided from a dedicated seeded stream so it is stable at any
            // resolution; the first and last lines are always written.
            const oRng = mulberry32((Math.imul(params.seed, 40503) ^ 0x51ED2701) >>> 0);
            const omittedRow = [];
            for (let r = 0; r < rows; r++)
                omittedRow[r] = (r > 0 && r < rows - 1) && oRng() < params.omit;
            // Edge-pair registers must exist on both sides of a boundary
            if (state.bleedL) for (const k of state.bleedL) omittedRow[k] = false;
            if (state.bleedR) for (const k of state.bleedR) omittedRow[k] = false;
            // Partial lines: some registers are only half written — starting
            // late, stopping early, or a fragment in the middle. Drawn from a
            // dedicated stream (4 draws per row, decisions never shift it).
            const pRng = mulberry32((Math.imul(params.seed, 68111) ^ 0x2C9277B5) >>> 0);
            const rowSpan = [];
            for (let r = 0; r < rows; r++) {
                const uP = pRng(), uT = pRng(), uA = pRng(), uB = pRng();
                let x0 = mL, x1 = 1 - mL;
                if (r < rows - 1 && uP < params.partial) {
                    if (uT < 0.45) {                       // starts late
                        x0 = mL + drawW * (0.08 + 0.50 * uA);
                    } else if (uT < 0.90) {                // stops early
                        x1 = mL + drawW * (0.45 + 0.45 * uB);
                    } else {                               // fragment mid-line
                        x0 = mL + drawW * (0.08 + 0.35 * uA);
                        x1 = Math.min(1 - mL, x0 + drawW * (0.25 + 0.40 * uB));
                    }
                }
                rowSpan[r] = { x0, x1 };
            }

            // Pen-lift ligature: within a line the hand doesn't lift between
            // every mark — 2–4 downstrokes chain in a continuous run, joined
            // foot-to-head by a faint drag, then the pen lifts and a new run
            // begins. runCont[i] marks a column as continuing the prior mark's
            // run. Dedicated seeded stream; stable at any resolution.
            const ligRng = mulberry32((Math.imul(params.seed, 19349663) ^ 0x85EBCA6B) >>> 0);
            const runContByRow = [];
            for (let r = 0; r < rows; r++) {
                const rc = new Array(perRow).fill(false);
                let rem = 0;
                for (let i = 0; i < perRow; i++) {
                    if (rem > 0) { rc[i] = true; rem--; }
                    else if (ligRng() < params.ligature) rem = 1 + Math.floor(ligRng() * 3);
                }
                runContByRow[r] = rc;
            }

            // ── FATIGUE LEDGER v1 (charter §V) ─────────────────────────────
            // The hand opens the sheet at F = 1. Every drawn mark costs work
            // in proportion to the pressure it actually bore; every omitted
            // register is a rest that returns ρ = 0.22 of the accumulated
            // debt. F = exp(−work/capacity) is a pure function of the writing
            // order — deterministic and resolution-independent. As F falls the
            // writing shows it: tremor rises, the pressure ceiling drops,
            // pen-lift gaps widen, marks are more often refused. κ
            // (params.fatigue) is the published constitutional severity;
            // κ = 0 is a tireless hand (ledger open, never charged).
            const fatK = params.fatigue;
            const fatCap = Math.max(1, rows * perRow * 0.08);
            const FAT_RHO = 0.22;
            let fatW = 0, fatRests = 0;
            const fatF = () => Math.exp(-fatW / fatCap);

            const hitsOmitted = (y0, y1) => {
                for (let k = 0; k < rows; k++) {
                    const rt = mT + rowTops[k];
                    if (rt > y1) break;
                    if (!omittedRow[k]) continue;
                    const bandT = rt + rowHs[k] * 0.12;
                    const bandB = rt + rowHs[k] * 0.88;
                    if (Math.min(y1, bandB) - Math.max(y0, bandT) > rowHs[k] * 0.10) return true;
                }
                return false;
            };

            // (Toned ground omitted — strokes sit directly on the paper.)

            // 1) STROKES: two populations — dark working strokes and pale
            // lifted strokes — long enough to overlap the register below.
            const insLastX = new Array(rows).fill(-1);   // where each register's ink truly ends
            for (let r = 0; r < rows; r++) {
                // per-register material remaining (AMEND-031): thins the writing where the work thinned
                const dm = _ductusDecayAt(rows > 1 ? r / (rows - 1) : 0);
                // A skipped register is a rest: part of the debt is returned
                if (omittedRow[r]) { fatW *= (1 - FAT_RHO); fatRests++; }
                const rowTopN = mT + rowTops[r];
                const rH = rowHs[r];
                const runCont = runContByRow[r];
                let penDown = false, pbx = 0, pby = 0;   // previous mark's foot
                let runYoff = 0;                          // shared baseline per run
                let xCursor = (state.bleedL && state.bleedL.has(r)) ? 0.006 : mL;
                const xStop = (state.bleedR && state.bleedR.has(r)) ? 0.994 : 1 - mL;

                for (let i = 0; i < perRow; i++) {
                    // The lift: when a new run begins the pen has left the
                    // paper and moved on, opening a small gap — so runs read
                    // as discrete clusters of 2–4 marks (the shape of writing).
                    if (i > 0 && !runCont[i])
                        xCursor += spacing * params.ligature * (0.7 + noise(r * 5 + 3, i * 0.7) * 1.8)
                                 * (1 + 1.4 * fatK * (1 - fatF()));   // the tired hand lifts longer
                    const nx = xCursor;
                    xCursor += spacing;
                    if (nx > xStop) break;

                    // Column undulation (cloth wave shared down each column)
                    const colShift = colWave(nx)
                                   + wobAmp * 0.8 * (noise(nx * 11 + 57, r * 0.05) - 0.5);
                    const nyTop = rowTopN + colShift;

                    // Fatigue at this instant: the ceiling the hand can still bear
                    const tired = fatK * (1 - fatF());
                    const p = pressureAt(nx, nyTop, r) * (1 - 0.45 * tired);
                    const u = rng();               // draw all rng in fixed order
                    const u2 = rng(), u3 = rng(), u4 = rng(), u5 = rng(),
                          uL = rng(), uW = rng(), uG = rng();

                    // Uniform stroke height WITHIN a line (each line's ticks
                    // match its own register height); lines differ from one
                    // another. A whisper of jitter keeps the hand alive.
                    const lenN = rH * (1.28 + 0.08 * (u3 - 0.5));
                    // Marks in one run share a baseline (so their connectors
                    // read as writing); each new run picks a fresh staggered
                    // baseline, which also keeps register boundaries dissolved.
                    if (!runCont[i]) runYoff = (u5 - 0.5) * rH * 0.4;
                    const y0N = nyTop - rH * 0.12 + runYoff;

                    // Compositional spine at this mark: concentrate marks
                    // toward the focus, thin them at the periphery (release).
                    const spine = spineAt(nx, y0N);
                    const densMul = 1 - params.composition * 0.30
                                      + params.composition * 0.55 * spine;

                    // Soft irregular boundary: existence fades across the bow
                    // and wander of all four edges. Edge-pair registers bleed
                    // to the very cut edge instead (the writing reaches for
                    // its neighbour across the gutter).
                    const bl = state.bleedL && state.bleedL.has(r);
                    const br = state.bleedR && state.bleedR.has(r);
                    let fL = clampN((nx - xLeft(nyTop)) / mX + 1, 0, 1);
                    let fR = clampN((xRight(nyTop) - nx) / mX + 1, 0, 1);
                    if (bl) fL = 1;
                    if (br) fR = 1;
                    const fT = clampN((y0N - yTop(nx)) / mY + 1, 0, 1);
                    const fB = clampN((yBotW(nx) - (y0N + lenN)) / mY + 1, 0, 1);
                    // Partial-line span for this register (soft hand ends)
                    const sp0 = rowSpan[r];
                    const sp = (bl || br)
                        ? { x0: bl ? -0.02 : sp0.x0, x1: br ? 1.02 : sp0.x1 } : sp0;
                    const fS = clampN((nx - sp.x0) / (mX * 1.5) + 1, 0, 1);
                    const fE = clampN((sp.x1 - nx) / (mX * 1.5) + 1, 0, 1);

                    const edgeProb = fL * fR * fT * fB * fS * fE;
                    if (edgeProb <= 0) { penDown = false; continue; }

                    if (hitsOmitted(y0N, y0N + lenN)) { penDown = false; continue; } // skipped line
                    if (u > params.density * densMul * edgeProb * (1 - 0.30 * tired) * dm) { penDown = false; continue; } // hand lifted (oftener when tired; thinner where the work decayed — AMEND-031)
                    if (u2 < 0.015) { penDown = false; continue; }  // rare true skip
                    fatW += p;                     // the mark is paid for in strength

                    // ── INK: integrate the real path length, drain a finite
                    // pen, and let it die honestly. markLen is the plotter
                    // path this mark inks (the downstroke, plus the drag into
                    // it when it continues a run).
                    const markLen = lenN + (runCont[i] ? spacing : 0);
                    pen.totalM += markLen * (pen.sheetCm / 100);
                    pen.markN++;
                    let inkAlpha = 1;
                    if (pen.on) {
                        const need = markLen * (pen.sheetCm / 100) * penPerM();   // µl
                        if (pen.left <= 0) {                       // dry: no ink leaves the nib
                            if (pen.dryMarkN < 0) { pen.dryMarkN = pen.markN; pen.dryX = nx; pen.dryRow = r; }
                            penDown = false; continue;
                        }
                        const starve = pen.reservoir * 0.045;      // the last breaths
                        if (pen.left < starve) {
                            inkAlpha = pen.left / starve;          // pales toward nothing
                            if (rng() > 0.30 + 0.70 * inkAlpha) {  // skips, oftener as it dries
                                pen.left -= need * 0.35;           // a dry skip still bleeds a little
                                penDown = false; continue;
                            }
                        }
                        pen.left -= need;
                    }
                    if (nx > insLastX[r]) insLastX[r] = nx;   // the ledger of where ink reached

                    const slantLoc = params.slant
                        + state.slantDrift * (noise(nx * 2 + 13, nyTop * 2 + 13) - 0.5) * 2
                        + (u4 - 0.5) * 0.06               // slight per-tick hand wobble
                        + (noise(nx*17+3, y0N*17+3) - 0.5) * params.composition * spine * 0.35; // agitation near focus
                    const dxN = Math.tan(slantLoc) * lenN; // STRAIGHT: one direction per tick

                    // Resolve this stroke's pencil/ink (mixed pot draws per stroke)
                    const smed = params.medium === MIXED_MEDIUM
                        ? PENCILS[Math.floor(uG * PENCILS.length)] : baseMed;

                    // Line weight: fixed mode, or drawn per stroke when mixed
                    const wf = params.weightMode === 3 ? (0.6 + uW * 1.1) : WFIX[params.weightMode];
                    const edgeA = 0.6 + 0.4 * edgeProb;

                    const isLight = uL < state.lightProb;
                    let alpha, wgt;
                    if (isLight) {
                        // Pale striation scratched over the tone — long, thin,
                        // quiet; brightest where the hand pressed least.
                        alpha = smed.alpha * 0.35 * (0.5 + 0.5 * (1 - p)) * edgeA;
                        wgt = smed.weight * wf * (0.40 + 0.35 * p) * Ws;
                    } else {
                        alpha = smed.alpha * (0.30 + 0.70 * Math.pow(p, 1.5)) * edgeA;
                        wgt = smed.weight * wf * (0.55 + 0.85 * p) * Ws;
                        if (rng() < 0.004) { alpha = Math.min(1, alpha * 1.8); wgt *= 1.6; } // blot
                    }
                    alpha *= inkAlpha;             // the starving nib fades its ink
                    const col = isLight ? mixRgb(paperRGB, smed.rgb, 0.12) : smed.rgb;

                    const X = nx * W, Y = y0N * W;
                    const L = lenN * W, DX = dxN * W;

                    // Pen-lift ligature: if this mark continues a run and the
                    // pen is still down, drag a faint stroke from the previous
                    // mark's foot up to this mark's head — light and quick, the
                    // way a real hand connects letters. Bowed, not ruled.
                    if (!isLight && runCont[i] && penDown) {
                        const midx = (pbx + X) / 2 + (noise(nx * 40 + 7, r * 3.1) - 0.5) * spacing * W * 2.5;
                        const midy = (pby + Y) / 2 + (noise(nx * 40 + 71, r * 3.1) - 0.5) * L * 0.25;
                        if (VEC) {
                            const q = [];
                            for (let t = 0; t <= 1.0001; t += 0.25) {
                                const it = 1 - t;
                                q.push([it*it*pbx + 2*it*t*midx + t*t*X,
                                        it*it*pby + 2*it*t*midy + t*t*Y]);
                            }
                            VEC.push({ pts: q, col, w: Math.max(0.5, wgt * 0.5) });
                        } else {
                            g.noFill();
                            g.stroke(col[0], col[1], col[2], alpha * (0.35 + 0.25 * p) * 255);
                            g.strokeWeight(Math.max(0.4 * Ws, wgt * 0.55));
                            g.beginShape();
                            g.vertex(pbx, pby);
                            g.quadraticVertex(midx, midy, X, Y);
                            g.endShape();
                        }
                    }

                    // Hand tremor: two interior deviations shared by all the
                    // stroke's hairlines — straight at arm's length, alive up
                    // close, never a curve function.
                    const tremPx = params.tremor * (1 + params.composition * 1.4 * spine)
                                 * (1 + 1.6 * tired) * L;   // fatigue shakes the line
                    const o1 = (rng() - 0.5) * 2 * tremPx;
                    const o2 = (rng() - 0.5) * 2 * tremPx;
                    const segLen = Math.hypot(DX, L) || 1;
                    const pxn = -L / segLen, pyn = DX / segLen;

                    // B-series smudge: faint wide graphite halo under the line
                    if (smed.halo > 0 && !isLight && !VEC) {
                        g.stroke(col[0], col[1], col[2], alpha * smed.halo * 0.35 * 255);
                        g.strokeWeight(wgt * 2.4);
                        g.line(X, Y, X + DX, Y + L);
                    }

                    // Per-stroke pressure envelope: the point touches down
                    // light, bears through a peak, lifts off light. Peak
                    // position and end-floor vary per mark — a front-loaded
                    // stab, an even middle, a trailing release — so no two
                    // strokes carry their weight alike. Rendered as filled
                    // tapered blades, accumulated for grain and ink texture.
                    const pk  = 0.26 + rng() * 0.48;       // where the hand bears down
                    const flr = 0.08 + rng() * 0.20;       // ends never fully vanish
                    const env = t => {
                        const tt = t < pk ? t / pk : (1 - t) / (1 - pk);
                        return flr + (1 - flr) * Math.pow(clampN(tt, 0, 1), 0.7);
                    };
                    const peakHW = 0.5 * wgt * 1.35;
                    const minHW = 0.15 * Ws;
                    const TS = [0, 0.16, 0.34, 0.5, 0.66, 0.84, 1];

                    g.noStroke();
                    for (let s = 0; s < smed.subs; s++) {
                        const ox = (rng() - 0.5) * spacing * W * smed.scatter;
                        const oy = (rng() - 0.5) * lenN * W * 0.12;
                        const ex = (rng() - 0.5) * spacing * W * 0.5;
                        const fl = rng();
                        // Centreline control points (tremor + this hairline's offset)
                        const cx = [X + ox, X + ox + DX/3 + pxn*o1,
                                    X + ox + 2*DX/3 + pxn*o2, X + ox + DX + ex];
                        const cy = [Y + oy, Y + oy + L/3 + pyn*o1,
                                    Y + oy + 2*L/3 + pyn*o2, Y + oy + L];
                        // Architect overshoot: extend both ends slightly along
                        // the stroke so marks cross past their corners (also
                        // carried into the plotter export).
                        if (smed.arch) {
                            const osh = smed.overshoot * L;
                            const ux = DX / segLen, uy = L / segLen;
                            cx[0] -= ux*osh; cy[0] -= uy*osh;
                            cx[3] += ux*osh; cy[3] += uy*osh;
                        }
                        const cAt = t => {
                            const seg = Math.min(2, Math.floor(t * 3)), lt = t * 3 - seg;
                            return [cx[seg] + (cx[seg+1]-cx[seg])*lt,
                                    cy[seg] + (cy[seg+1]-cy[seg])*lt];
                        };
                        if (VEC) {
                            // Plotter: emit ONE clean centreline per mark (the
                            // first hairline), no width, no overdraw. Tone is
                            // carried by how many marks the composition places.
                            if (s === 0) {
                                const line = TS.map(t => { const c = cAt(t); return [c[0], c[1]]; });
                                VEC.push({ pts: line, col, w: Math.max(0.5, wgt * 0.85) });
                            }
                            continue;
                        }
                        if (smed.impasto) {
                            // Impasto: thick paint standing off the surface.
                            // Faked in 3D — a cast shadow on the dark side, the
                            // opaque body, and a bright highlight ridge on the
                            // light side (lit from upper-left) — so the stroke
                            // reads as a raised, sculptural bead of paint.
                            const hw = Math.max(0.5 * Ws, wgt * 1.15);
                            const r = smed.relief;
                            const shCol = [clampN(col[0]-22,0,255), clampN(col[1]-22,0,255), clampN(col[2]-15,0,255)];
                            const hiCol = mixRgb(col, [240, 236, 226], 0.72);
                            const blade = (dx, dy, half, cc, a) => {
                                g.noStroke();
                                g.fill(cc[0], cc[1], cc[2], a * 255);
                                g.beginShape();
                                for (let k = 0; k < TS.length; k++) {
                                    const c = cAt(TS[k]), w = half * env(TS[k]);
                                    g.vertex(c[0] + dx + pxn*w, c[1] + dy + pyn*w);
                                }
                                for (let k = TS.length - 1; k >= 0; k--) {
                                    const c = cAt(TS[k]), w = half * env(TS[k]);
                                    g.vertex(c[0] + dx - pxn*w, c[1] + dy - pyn*w);
                                }
                                g.endShape(CLOSE);
                            };
                            if (s === 0) {
                                // cast shadow (toward the shadow side) then body
                                blade(pxn*wgt*0.7*r + wgt*0.35*r, pyn*wgt*0.7*r + wgt*0.35*r,
                                      hw*1.06, shCol, alpha * 0.55);
                                blade(0, 0, hw, col, alpha);
                            } else if (s < smed.subs - 1) {
                                blade(ox*0.25, oy*0.25, hw*0.92, col, alpha * 0.5);   // body texture
                            } else {
                                // final pass on top: reinforce body, lay highlight ridge
                                blade(0, 0, hw*0.96, col, alpha * 0.6);
                                blade(-pxn*wgt*0.5*r - wgt*0.28*r, -pyn*wgt*0.5*r - wgt*0.28*r,
                                      hw*0.42, hiCol, alpha * 0.9);
                            }
                            continue;
                        }
                        if (smed.cami) {
                            // Camisado: a loose loaded paint stroke — blotchy
                            // opaque body with ragged edges, and the accidents
                            // of a full brush: an occasional drip trailing off
                            // the foot, and flecks of spatter.
                            const hw = Math.max(0.5 * Ws, wgt * 1.2);
                            g.noStroke();
                            g.fill(col[0], col[1], col[2],
                                alpha * (0.85 + 0.15 * noise(nx * 40 + s, y0N * 40)) * 255);
                            g.beginShape();
                            for (let k = 0; k < TS.length; k++) {
                                const c = cAt(TS[k]);
                                const w = hw * env(TS[k]) * (1 + 0.4 * (noise(nx*72 + k*5, y0N*72 + s*2) - 0.5) * 2);
                                g.vertex(c[0] + pxn*w, c[1] + pyn*w);
                            }
                            for (let k = TS.length - 1; k >= 0; k--) {
                                const c = cAt(TS[k]);
                                const w = hw * env(TS[k]) * (1 + 0.4 * (noise(nx*72 + k*5 + 33, y0N*72 + s*2 + 7) - 0.5) * 2);
                                g.vertex(c[0] - pxn*w, c[1] - pyn*w);
                            }
                            g.endShape(CLOSE);
                            if (s === 0) {
                                const fx = X + DX, fy = Y + L;
                                if (noise(nx * 33 + 1, y0N * 33) < smed.drip) {     // a drip off the foot
                                    const dl = L * (0.7 + 1.8 * noise(nx * 12, y0N * 12));
                                    const dx2 = (noise(nx * 15 + 4, y0N * 15) - 0.5) * wgt * 1.5;
                                    g.stroke(col[0], col[1], col[2], alpha * 0.75 * 255);
                                    g.strokeWeight(Math.max(0.5 * Ws, wgt * 0.35));
                                    g.noFill();
                                    g.line(fx, fy, fx + dx2, fy + dl);
                                    g.noStroke();
                                    g.fill(col[0], col[1], col[2], alpha * 0.85 * 255);
                                    g.circle(fx + dx2, fy + dl, Math.max(1, wgt * 0.9));
                                }
                                if (noise(nx * 29 + 7, y0N * 29) < smed.spatter) {  // spatter flecks
                                    for (let d = 0; d < 5; d++) {
                                        const a2 = noise(nx * 50 + d * 3.1, y0N * 50 + d * 2);
                                        if (a2 < 0.55) continue;
                                        const sx = fx + (noise(nx * 60 + d * 4, 3) - 0.5) * spacing * W * 5;
                                        const sy = Y + L * noise(d * 7 + 1, y0N * 20) + (noise(d + 2, nx * 9) - 0.5) * L * 0.4;
                                        g.noStroke();
                                        g.fill(col[0], col[1], col[2], alpha * 0.55 * 255);
                                        g.circle(sx, sy, Math.max(0.6 * Ws, wgt * 0.5 * a2));
                                    }
                                }
                            }
                            continue;
                        }
                        if (smed.claw) {
                            // Claw/rake: each sub is one tine — a thin, sharp,
                            // scratchy tapered track offset across the width,
                            // with gaps left between tines so the paper shows
                            // through (the marks of a claw dragged over it).
                            const nb = smed.subs;
                            const spread = smed.spreadW * wgt;
                            const off = (nb <= 1 ? 0 : (s / (nb - 1) - 0.5)) * 2 * spread
                                      + (fl - 0.5) * wgt * 0.3;
                            const bx0 = X + pxn * off, by0 = Y + pyn * off;
                            const cxo = [bx0, bx0 + DX/3 + pxn*o1, bx0 + 2*DX/3 + pxn*o2, bx0 + DX];
                            const cyo = [by0, by0 + L/3 + pyn*o1, by0 + 2*L/3 + pyn*o2, by0 + L];
                            const cAtC = t => {
                                const seg = Math.min(2, Math.floor(t * 3)), lt = t * 3 - seg;
                                return [cxo[seg] + (cxo[seg+1]-cxo[seg])*lt,
                                        cyo[seg] + (cyo[seg+1]-cyo[seg])*lt];
                            };
                            g.noFill();
                            const bw = Math.max(0.4 * Ws, wgt * 0.45);
                            const nSeg = 7;
                            for (let k = 0; k < nSeg; k++) {
                                const ta = k / nSeg, tb = (k + 1) / nSeg;
                                if (noise(nx * 95 + k * 2.7, y0N * 95 + s * 5) < smed.grain * 0.5) continue; // scratch gap
                                const ca = cAtC(ta), cb = cAtC(tb), em = env((ta + tb) / 2);
                                g.stroke(col[0], col[1], col[2],
                                    alpha * (0.7 + 0.3 * noise(k * 3.3 + s, nx * 25)) * 255);
                                g.strokeWeight(Math.max(0.35 * Ws, bw * em));
                                g.line(ca[0], ca[1], cb[0], cb[1]);
                            }
                            continue;
                        }
                        if (smed.paint) {
                            // Painted brush: a solid, opaque painterly stroke.
                            // Ragged paint edges (width perturbed independently
                            // on each side) and a faint internal drag streak.
                            const hw = Math.max(0.5 * Ws, wgt * 1.15);
                            const eg = smed.edge;
                            g.noStroke();
                            g.fill(col[0], col[1], col[2],
                                alpha * (0.85 + 0.15 * noise(nx * 40 + s, y0N * 40)) * 255);
                            g.beginShape();
                            for (let k = 0; k < TS.length; k++) {
                                const c = cAt(TS[k]);
                                const w = hw * env(TS[k]) * (1 + eg * (noise(nx*70 + k*5.1, y0N*70 + s*2) - 0.5) * 2);
                                g.vertex(c[0] + pxn*w, c[1] + pyn*w);
                            }
                            for (let k = TS.length - 1; k >= 0; k--) {
                                const c = cAt(TS[k]);
                                const w = hw * env(TS[k]) * (1 + eg * (noise(nx*70 + k*5.1 + 40, y0N*70 + s*2 + 9) - 0.5) * 2);
                                g.vertex(c[0] - pxn*w, c[1] - pyn*w);
                            }
                            g.endShape(CLOSE);
                            // internal paint drag: a faint lighter streak
                            if (s === 0) {
                                const lt = mixRgb(col, paperRGB, 0.22);
                                g.noFill();
                                g.stroke(lt[0], lt[1], lt[2], alpha * 0.35 * 255);
                                g.strokeWeight(Math.max(0.4 * Ws, wgt * 0.35));
                                g.beginShape();
                                for (let k = 0; k < TS.length; k++) {
                                    const c = cAt(TS[k]);
                                    g.vertex(c[0] + pxn*hw*0.3, c[1] + pyn*hw*0.3);
                                }
                                g.endShape();
                            }
                            continue;
                        }
                        if (smed.water) {
                            // Watercolour: a soft translucent wash — a faint
                            // bleed halo, a granular semi-opaque body, and a
                            // darker settled rim at the edges where the wet
                            // pigment dries. Overlap layers tone like real washes.
                            const hw = Math.max(0.6 * Ws, wgt);
                            const gr = 0.5 + 0.5 * noise(nx * 60 + s * 3.3, y0N * 60 + 1);
                            const blade = (half, a, cc) => {
                                g.noStroke();
                                g.fill(cc[0], cc[1], cc[2], a * 255);
                                g.beginShape();
                                for (let k = 0; k < TS.length; k++) {
                                    const c = cAt(TS[k]), w = half * env(TS[k]);
                                    g.vertex(c[0] + pxn*w, c[1] + pyn*w);
                                }
                                for (let k = TS.length - 1; k >= 0; k--) {
                                    const c = cAt(TS[k]), w = half * env(TS[k]);
                                    g.vertex(c[0] - pxn*w, c[1] - pyn*w);
                                }
                                g.endShape(CLOSE);
                            };
                            if (s === 0) blade(hw * smed.bleed, alpha * 0.35, col);   // bleed halo
                            blade(hw, alpha * gr * (1 - smed.grain * 0.35), col);      // granular body
                            if (s === smed.subs - 1) {                                 // settled rim
                                const dk = mixRgb(col, [8, 8, 16], 0.4);
                                g.noFill();
                                g.stroke(dk[0], dk[1], dk[2], alpha * 1.2 * 255);
                                g.strokeWeight(Math.max(0.5 * Ws, wgt * 0.35));
                                for (const sgn of [1, -1]) {
                                    g.beginShape();
                                    for (let k = 0; k < TS.length; k++) {
                                        const c = cAt(TS[k]), w = hw * env(TS[k]) * sgn;
                                        g.vertex(c[0] + pxn*w, c[1] + pyn*w);
                                    }
                                    g.endShape();
                                }
                            }
                            continue;
                        }
                        if (smed.arch) {
                            // Architect: a crisp, near-uniform technical line —
                            // no taper, minimal grain, overshooting its ends.
                            g.noFill();
                            g.stroke(col[0], col[1], col[2],
                                alpha * (1 - smed.grain * 0.4 * fl) * 255);
                            g.strokeWeight(Math.max(0.5 * Ws, wgt * 0.9));
                            g.beginShape();
                            for (let k = 0; k < TS.length; k++) {
                                const c = cAt(TS[k]);
                                g.vertex(c[0], c[1]);
                            }
                            g.endShape();
                            continue;
                        }
                        if (smed.oil) {
                            // Oil brush: a broad loaded body raked into parallel
                            // bristle grooves. Each sub is one bristle-blade,
                            // offset across the width; some are scumbled lighter,
                            // so the mark reads as wet paint dragged by bristles.
                            const nb = smed.subs;
                            const spread = smed.body * wgt;
                            const off = (nb <= 1 ? 0 : (s / (nb - 1) - 0.5)) * 2 * spread
                                      + (fl - 0.5) * wgt * 0.5;
                            const bx0 = X + pxn * off, by0 = Y + pyn * off;
                            const cxo = [bx0, bx0 + DX/3 + pxn*o1, bx0 + 2*DX/3 + pxn*o2, bx0 + DX];
                            const cyo = [by0, by0 + L/3 + pyn*o1, by0 + 2*L/3 + pyn*o2, by0 + L];
                            const cAtO = t => {
                                const seg = Math.min(2, Math.floor(t * 3)), lt = t * 3 - seg;
                                return [cxo[seg] + (cxo[seg+1]-cxo[seg])*lt,
                                        cyo[seg] + (cyo[seg+1]-cyo[seg])*lt];
                            };
                            const hw = Math.max(0.5 * Ws, wgt * 0.95);
                            const scum = noise(s * 7.3 + 3, nx * 20 + 1);
                            const bcol = scum < 0.32 ? mixRgb(col, paperRGB, 0.30 + 0.25 * scum) : col;
                            const ba = alpha * (0.5 + 0.5 * noise(s * 5.1, y0N * 40 + 2))
                                     * (0.7 + 0.3 * (1 - smed.grain));
                            g.noStroke();
                            g.fill(bcol[0], bcol[1], bcol[2], ba * 255);
                            g.beginShape();
                            for (let k = 0; k < TS.length; k++) {
                                const c = cAtO(TS[k]), w = hw * env(TS[k]);
                                g.vertex(c[0] + pxn*w, c[1] + pyn*w);
                            }
                            for (let k = TS.length - 1; k >= 0; k--) {
                                const c = cAtO(TS[k]), w = hw * env(TS[k]);
                                g.vertex(c[0] - pxn*w, c[1] - pyn*w);
                            }
                            g.endShape(CLOSE);
                            continue;
                        }
                        if (smed.brush) {
                            // Dry thin brush: a bristle streak — thin, tapered,
                            // broken by dry skips, frayed at both ends. Several
                            // bristles (subs) build the streaky brush body.
                            g.noFill();
                            const bw = Math.max(0.4 * Ws, wgt * 0.55);
                            const nSeg = 9;
                            const t0 = smed.fray * 0.32 * fl;
                            const t1 = 1 - smed.fray * 0.32 * noise(nx * 50 + s, y0N * 50);
                            for (let k = 0; k < nSeg; k++) {
                                const ta = t0 + (t1 - t0) * k / nSeg;
                                const tb = t0 + (t1 - t0) * (k + 1) / nSeg;
                                if (noise(nx * 90 + k * 2.3, y0N * 90 + s * 4) < smed.dry * 0.7) continue; // dry skip
                                const ca = cAt(ta), cb = cAt(tb);
                                const em = env((ta + tb) / 2);
                                const gr = 1 - smed.grain * 0.8 * noise(k * 3.1 + s * 2, nx * 30 + 5);
                                g.stroke(col[0], col[1], col[2], alpha * gr * 255);
                                g.strokeWeight(Math.max(0.35 * Ws, bw * em));
                                g.line(ca[0], ca[1], cb[0], cb[1]);
                            }
                            continue;
                        }
                        // Paper tooth: hard leads flicker on the grain
                        g.fill(col[0], col[1], col[2], alpha * (1 - smed.grain * 0.6 * fl) * 255);
                        g.beginShape();
                        for (let k = 0; k < TS.length; k++) {
                            const c = cAt(TS[k]), hw = Math.max(minHW, peakHW * env(TS[k]));
                            g.vertex(c[0] + pxn*hw, c[1] + pyn*hw);
                        }
                        for (let k = TS.length - 1; k >= 0; k--) {
                            const c = cAt(TS[k]), hw = Math.max(minHW, peakHW * env(TS[k]));
                            g.vertex(c[0] - pxn*hw, c[1] - pyn*hw);
                        }
                        g.endShape(CLOSE);
                    }

                    // Soft-lead pressure pooling: the middle of the tick darkens
                    if (smed.soft > 0.5 && !isLight && !VEC) {
                        g.stroke(col[0], col[1], col[2], alpha * 0.35 * 255);
                        g.strokeWeight(wgt * 1.2);
                        g.line(X + DX * 0.30, Y + L * 0.30, X + DX * 0.72, Y + L * 0.72);
                    }

                    // Pen stays down: remember this mark's foot for the next
                    // mark in the run. Light striations don't carry the pen.
                    if (!isLight) { penDown = true; pbx = X + DX; pby = Y + L; }
                    else penDown = false;
                }
            }

            // Close the day's books: the ledger is published, never hidden
            LAST_LEDGER = { F: +fatF().toFixed(4), kappa: fatK,
                            work: +fatW.toFixed(1), rests: fatRests };

            // THE DATE — the one legible line. When the seed is a date
            // (which, under the law, a conclusion always is), it is written
            // on the sheet itself, beginning where the final line stopped:
            // the inscription takes the place of the words that gave out.
            // Format: day.ROMAN-month.year — 14.VII.2026. On a wall, only
            // the final sheet carries it. Studies with non-date seeds
            // carry nothing.
            if (state.inscribe !== false && !VEC && !(pen.on && pen.left <= 0)) {
                const sN = state.inscribeSeed != null ? state.inscribeSeed : params.seed;
                const iy = Math.floor(sN / 10000), im = Math.floor(sN / 100) % 100, id = sN % 100;
                if (iy >= 1900 && iy <= 2100 && im >= 1 && im <= 12 && id >= 1 && id <= 31) {
                    const ROMAN = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'];
                    const txt = id + '.' + ROMAN[im - 1] + '.' + iy;
                    // The last register that actually received ink, and where
                    // its ink truly ends — observed from the marks, not theory
                    let lr = rows - 1;
                    while (lr > 0 && insLastX[lr] < 0) lr--;
                    const insH = rowHs[lr] * 0.92 * W;
                    g.textFont('Courier New'); g.textSize(insH);
                    g.textAlign(LEFT, BASELINE);
                    const tw = g.textWidth(txt);
                    let xI = (insLastX[lr] + 0.018) * W;
                    let yI = (mT + rowTops[lr] + rowHs[lr] * 0.86) * W;
                    if (xI + tw > (1 - mL) * W) {
                        // the final line left no room: the date drops below
                        // it, right-aligned — a colophon in the margin
                        xI = (1 - mL) * W - tw;
                        yI += rowHs[lr] * 1.6 * W;
                    }
                    g.noStroke();
                    g.fill(baseMed.rgb[0], baseMed.rgb[1], baseMed.rgb[2],
                           Math.min(1, baseMed.alpha * 1.5) * 255);
                    g.text(txt, xI, yI);
                }
            }

            // (Register seams omitted — no horizontal lines; the registers
            // exist only as the rhythm of the vertical strokes themselves.)

            // Texturize the ink: screen a fine seeded grain over the sheet.
            // Screen only lifts the darks, so the strokes break up into grainy
            // pigment while the paper stays clean. No flat digital black.
            if (!VEC && params.inkGrain > 0.001) {
                const gtex = getGrainTex(params.seed, W);
                g.blendMode(SCREEN);
                g.tint(255, params.inkGrain * 255);
                g.image(gtex, 0, 0, W, H);
                g.noTint();
                g.blendMode(BLEND);
            }

            // Blend with paper texture: multiply a seeded paper grain over the
            // whole sheet so every mark adopts the surface's tooth, highlights
            // and shadows. Skipped for the plotter export (pure vector).
            if (!VEC && params.paperTex > 0.001) {
                const tex = getPaperTex(params.seed, W);
                g.blendMode(MULTIPLY);
                g.tint(255, params.paperTex * 255);
                g.image(tex, 0, 0, W, H);
                g.noTint();
                g.blendMode(BLEND);
            }
        }

        function render() {
            const sheetH = Math.round(BASE_W * ASPECT);
            if (width !== BASE_W || height !== sheetH) resizeCanvas(BASE_W, sheetH);
            renderTo(window, BASE_W);
            pen.lastScope = 'sheet';
            updateInkUI();
        }

        // Read the finite-pen controls into the model, then re-render so the
        // drain is visible on the current sheet. (A wall must be re-composed
        // to redraw its cross-sheet drain — the readout says so.)
        function syncPen() {
            pen.on = document.getElementById('inkOn').checked;
            pen.reservoir = parseFloat(document.getElementById('inkReservoir').value) * 1000;
            pen.lineMm = parseFloat(document.getElementById('inkLineMm').value);
            pen.sheetCm = parseFloat(document.getElementById('inkSheetCm').value);
            render();
        }

        // The fuel gauge. Reports metres this pen would ink, what one load
        // holds, and whether it survives — for the last-rendered sheet or wall.
        function updateInkUI() {
            const el = document.getElementById('ink-readout');
            if (!el) return;
            const capM = penCapM();
            const scope = pen.lastScope;
            if (!pen.on) {
                el.textContent = 'pen: unlimited (ink ledger off)\n'
                    + scope + ' demands ' + pen.totalM.toFixed(1) + ' m of line · '
                    + 'one ' + (pen.reservoir / 1000).toFixed(2) + ' ml load at '
                    + pen.lineMm.toFixed(2) + ' mm holds ~' + capM.toFixed(0) + ' m'
                    + '  → ' + (pen.totalM <= capM ? 'would survive' : 'would run dry');
                return;
            }
            const pct = Math.max(0, Math.round(100 * pen.left / pen.reservoir));
            let line;
            if (scope === 'wall' && pen.drySheet >= 0) {
                line = 'RAN DRY at sheet ' + (pen.drySheet + 1) + ', stroke ' + pen.dryMarkN
                     + ' — the rest is bare paper; the wall is unsigned';
            } else if (scope !== 'wall' && pen.dryMarkN >= 0) {
                line = 'RAN DRY at stroke ' + pen.dryMarkN + ' — unfinished, unsigned';
            } else {
                line = 'survived · ' + pct + '% ink left (' + (pen.left / 1000).toFixed(2) + ' ml)';
            }
            el.textContent =
                'one ' + (pen.reservoir / 1000).toFixed(2) + ' ml load · ' + pen.lineMm.toFixed(2)
                + ' mm nib · ' + (pen.lineMm * pen.filmUm).toFixed(2) + ' µl/m\n'
                + scope + ' inked ' + pen.totalM.toFixed(1) + ' m of the ' + capM.toFixed(0) + ' m it holds\n'
                + line;
        }

        function setup() {
            pixelDensity(1);
            const canvas = createCanvas(BASE_W, BASE_W * ASPECT);
            canvas.parent('canvas-container');
            noLoop();
            const loading = document.querySelector('.loading');
            if (loading) loading.style.display = 'none';
            regenerate();
        }

        function draw() { /* static system; drawing happens in render() */ }

        function regenerate() {
            generate();
            refreshControls();
            render();
        }

        // ═══════════════════════════════════════════════════════════════════
        // WALL MODE — the polyptych. Doctrine (settled by evidence):
        //   · one weather system + one spine across all sheets;
        //   · the gutter is a counted rest (3R); baselines share the meter;
        //   · edge-pairs reach the cut edge, the eye completes them;
        //   · crossings: budget 2, declared, severed by the gutter;
        //   · one omitted sheet (blank panel); final line stops mid-wall;
        //   · one column syncopated by an integer kR (masonry breaks,
        //     the music doesn't) — the legal break;
        //   · one sheet fallen below the grid, its slot left vacant, its
        //     weather still that of the place it fell from — the scored event.
        // The score is public: drawn onto the artifact and shown beside it.
        // ═══════════════════════════════════════════════════════════════════
        let wallG = null, wallScoreText = '', wallExport = null;

        async function composeWall(scale = 1, silent = false) {
            const scoreDiv = document.getElementById('wall-score');
            const wallSeed = params.seed;
            const wr = mulberry32((Math.imul(wallSeed, 48271) ^ 0x2545F491) >>> 0);

            // THE FORMAT IS LAW: the date draws its own grid — from a single
            // sheet (1×1) to a 6×6 polyptych, every combination lawful. The
            // sliders override only for studies, and the score says so.
            const gCols = 1 + Math.floor(wr() * 6);
            const gRows = 1 + Math.floor(wr() * 6);
            const lawGrid = !document.getElementById('wallGridOverride').checked;
            const cols = lawGrid ? gCols : parseInt(document.getElementById('wallCols').value);
            const rowsW = lawGrid ? gRows : parseInt(document.getElementById('wallRows').value);

            // ---- Wall constants (normalized in sheet-width units) ----
            // scale > 1 re-executes the whole composition at print density.
            const SWpx = Math.round(420 * scale);      // per-sheet render width
            const rowH = 0.02;                         // the meter, shared by all sheets
            const mTB = 0.05;                          // uniform sheet margins (baseline lock)
            const Rpx = rowH * SWpx;
            const gutN = 3 * rowH, gutPx = 3 * Rpx;    // the counted rest
            const SHpx = Math.round(SWpx * ASPECT);
            const nRegs = Math.floor((ASPECT - 2 * mTB) / rowH + 1e-9);
            const wallWn = cols + (cols - 1) * gutN;
            const wallHn = rowsW * ASPECT + (rowsW - 1) * gutN;
            const M = Math.round(46 * scale);
            const shd = Math.max(1, Math.round(3 * scale));   // drop-shadow offset

            // ---- The plan (all seeded from the wall seed) ----
            const total = cols * rowsW;
            const lastR = rowsW - 1, lastC = cols - 1;
            const uBlank = wr(), uSynco = wr(), uFall = wr();
            const hasBlank = total >= 4 && uBlank < 0.35;
            const hasSynco = cols >= 2 && total >= 4 && uSynco < 0.50;
            const hasFall  = total >= 3 && uFall < 0.35;
            let blankR = Math.floor(wr() * rowsW), blankC = Math.floor(wr() * cols);
            if (blankR === lastR && blankC === lastC) blankC = Math.max(0, lastC - 1);
            let syncoCol = Math.floor(wr() * cols);
            if (hasBlank && syncoCol === blankC) syncoCol = (syncoCol + 1) % cols;
            const syncoK = 2 + Math.floor(wr() * 3);   // integer R — syncopation
            let fallC = Math.floor(wr() * cols);
            let guard = 0;
            while (((hasSynco && fallC === syncoCol) || (hasBlank && blankR === lastR && fallC === blankC)
                    || (cols > 1 && fallC === lastC)) && guard++ < 8)
                fallC = (fallC + 1) % cols;
            const fallR = lastR;                       // gravity: the fall starts at the bottom row
            const isBlank = (r, c) => hasBlank && r === blankR && c === blankC;
            const isVacant = (r, c) => hasFall && r === fallR && c === fallC;

            // Wall weather: one spine, one blob set, in wall coordinates
            const spineW = { x: (0.28 + wr() * 0.3) * wallWn, y: (0.25 + wr() * 0.25) * wallHn,
                             rx: 0.20 * wallWn, ry: 0.24 * wallHn };
            const wallBlobs = [];
            for (let i = 0; i < 6; i++) wallBlobs.push({
                x: wr() * wallWn, y: wr() * wallHn,
                r: (0.10 + wr() * 0.15) * wallWn, amp: (i < 4 ? 1 : -1) * (0.4 + wr() * 0.4) });
            const wallFS = 2.5, wallComp = 0.8;
            const wallPaper = '#f0ede4';

            // ONE HAND FOR THE WHOLE WALL (charter v1.1): the date draws the
            // instrument, the lean and the weight once; sheets keep only
            // their private grain — rests, runs, breaks, fatigue.
            const wallMedium = (() => {
                const mr = wr();
                return mr < 0.07 ? 0 : mr < 0.12 ? 1
                     : mr < 0.21 ? BRUSH0 + Math.floor(wr() * BRUSHES.length)
                     : mr < 0.30 ? OIL0 + Math.floor(wr() * OILS.length)
                     : mr < 0.39 ? ARCH0 + Math.floor(wr() * ARCHITECTS.length)
                     : mr < 0.48 ? WATER0 + Math.floor(wr() * WATERS.length)
                     : mr < 0.54 ? PAINT0 + Math.floor(wr() * PAINTED.length)
                     : mr < 0.61 ? CLAW0 + Math.floor(wr() * CLAWS.length)
                     : mr < 0.69 ? CAMI0 + Math.floor(wr() * CAMISADO.length)
                     : mr < 0.77 ? IMP0 + Math.floor(wr() * IMPASTO.length)
                     : 2 + Math.floor(wr() * PENCILS.length);   // never the mixed pot: one instrument
            })();
            const wallSlant = 0.05 + wr() * 0.15;                // one lean
            const wallWeight = Math.floor(wr() * 3);             // one weight, never mixed

            // Edge-pairs: two shared registers per eligible boundary
            const pairs = [];
            for (let r = 0; r < rowsW; r++) for (let c = 0; c < cols - 1; c++) {
                if (isBlank(r, c) || isBlank(r, c + 1) || isVacant(r, c) || isVacant(r, c + 1)) continue;
                const regs = [];
                let g2 = 0;
                while (regs.length < 2 && g2++ < 40) {
                    const k = 3 + Math.floor(wr() * (nRegs - 6));
                    if (!regs.includes(k)) regs.push(k);
                }
                pairs.push({ r, cL: c, regs });
            }
            // Crossings: budget scales with the format, never at the
            // syncopated column's boundaries
            const xCand = pairs.filter(p => !hasSynco || (p.cL !== syncoCol && p.cL + 1 !== syncoCol));
            const xBudget = total >= 6 ? 2 : (total >= 2 ? 1 : 0);
            const crossings = [];
            let xGuard = 0;
            while (crossings.length < Math.min(xBudget, xCand.length) && xGuard++ < 60) {
                const p = xCand[Math.floor(wr() * xCand.length)];
                if (!crossings.includes(p)) crossings.push(p);
            }

            // ---- Canvas ----
            const dropPx = hasSynco ? syncoK * Rpx : 0;
            const scoreBand = Math.round(((cols < 3 ? 200 : 116) + (pen.on ? 20 : 0)) * scale);
            const fallZone = hasFall ? SHpx + gutPx : 0;
            const WW = 2 * M + cols * SWpx + (cols - 1) * gutPx;
            const WH = 2 * M + rowsW * SHpx + (rowsW - 1) * gutPx + dropPx + fallZone + scoreBand;
            const G = createGraphics(WW, WH);
            G.pixelDensity(1);
            G.background('#d8d3c7');
            const shX = c => M + c * (SWpx + gutPx);
            const shY = (r, c) => M + r * (SHpx + gutPx) + (hasSynco && c === syncoCol ? dropPx : 0);
            const gridBot = M + rowsW * SHpx + (rowsW - 1) * gutPx + dropPx;

            // ---- Per-sheet configuration (shared by preview and export) ----
            // Mutates params/state for sheet (r,c); caller renders at any size.
            const applySheet = (r, c) => {
                const si = r * cols + c;
                params.seed = wallSeed * 97 + si * 131 + 11;
                generate();
                params.medium = wallMedium;
                params.slant = wallSlant;
                params.weightMode = wallWeight;
                params.rowH = rowH; state.rowVar = 0;
                state.mL = 0.06; state.mT = mTB; state.mB = mTB;
                state.spacing = Math.max(state.spacing, 0.0011) * 1.8;
                state.paper = wallPaper;
                state.noiseSeedOverride = wallSeed;
                state.fieldScale = wallFS;
                params.patchiness = 0.5; params.band = 0.08;
                params.composition = wallComp;
                state.fieldOffX = c * (1 + gutN);
                state.fieldOffY = r * (ASPECT + gutN) + (hasSynco && c === syncoCol ? syncoK * rowH : 0);
                state.focalX = spineW.x; state.focalY = spineW.y;
                state.focalRX = spineW.rx; state.focalRY = spineW.ry;
                state.blobs = wallBlobs;
                state.endFrac = (r === lastR && c === lastC) ? 0.45 : 0.999;
                state.inscribe = (r === lastR && c === lastC);   // the date signs only the final sheet
                state.inscribeSeed = wallSeed;                   // ...and signs the WALL's date, not the sheet's
                state.bleedL = new Set(pairs.filter(p => p.r === r && p.cL === c - 1).flatMap(p => p.regs));
                state.bleedR = new Set(pairs.filter(p => p.r === r && p.cL === c).flatMap(p => p.regs));
            };

            // ---- Render sheets through the full engine ----
            const pSnap = { ...params }, sSnap = { ...state, blobs: [...state.blobs] };
            // One ink load drains across the whole wall, in reading order.
            pen.managed = true; pen.left = pen.reservoir;
            pen.totalM = 0; pen.markN = 0; pen.dryMarkN = -1; pen.drySheet = -1;
            for (let r = 0; r < rowsW; r++) for (let c = 0; c < cols; c++) {
                const si = r * cols + c;
                if (!silent) {
                    scoreDiv.textContent = 'Composing sheet ' + (si + 1) + ' / ' + total + '…';
                    await new Promise(res => setTimeout(res, 10));
                }
                const x = shX(c), yStd = shY(r, c);
                const yDraw = isVacant(r, c) ? gridBot + gutPx : yStd;   // the fall
                if (isBlank(r, c)) {
                    G.noStroke(); G.fill(0, 0, 0, 26); G.rect(x + shd, yStd + Math.round(shd * 1.3), SWpx, SHpx);
                    G.fill(wallPaper); G.rect(x, yStd, SWpx, SHpx);
                    continue;
                }
                applySheet(r, c);
                const sg = createGraphics(SWpx, SHpx);
                sg.pixelDensity(1);
                renderTo(sg, SWpx);
                if (pen.on && pen.left <= 0 && pen.drySheet < 0) pen.drySheet = si;   // where it gave out
                G.noStroke(); G.fill(0, 0, 0, 26); G.rect(x + shd, yDraw + Math.round(shd * 1.3), SWpx, SHpx);
                G.image(sg, x, yDraw);
                sg.remove();
            }
            pen.managed = false;

            // ---- Crossings: severed wall-ligatures, clipped by the gutter ----
            const ctx = G.drawingContext;
            for (const cr of crossings) {
                const reg = cr.regs[0];
                const ax = shX(cr.cL) + SWpx, bx = shX(cr.cL + 1);
                const y1 = shY(cr.r, cr.cL) + (mTB + (reg + 1.02) * rowH) * SWpx;
                const y2 = shY(cr.r, cr.cL + 1) + (mTB + (reg - 0.02) * rowH) * SWpx;
                for (const side of [cr.cL, cr.cL + 1]) {
                    ctx.save(); ctx.beginPath();
                    ctx.rect(shX(side), shY(cr.r, side), SWpx, SHpx); ctx.clip();
                    G.noFill(); G.stroke(40, 38, 40, 220); G.strokeWeight(2.0 * scale);
                    G.beginShape();
                    G.vertex(ax - 8 * scale, y1);
                    G.quadraticVertex((ax + bx) / 2, (y1 + y2) / 2 + 6 * scale, bx + 8 * scale, y2);
                    G.endShape();
                    ctx.restore();
                }
            }

            // ---- The public score, on the artifact itself ----
            const P = (r, c) => '(' + (r + 1) + ',' + (c + 1) + ')';
            const breaksTxt = [
                hasSynco ? 'column ' + (syncoCol + 1) + ' syncopated −' + syncoK + 'R (baselines still rhyme)' : null,
                hasFall ? 'sheet ' + P(fallR, fallC) + ' fallen below the grid, slot vacant, retains origin weather' : null
            ].filter(Boolean).join(' · ');
            wallScoreText =
                'ΠΡΑΚΤΙΚΑ · seed ' + wallSeed +
                ' · grid ' + cols + '×' + rowsW + (lawGrid ? ' — the date drew its format' : ' — OVERRIDDEN (study)') +
                ' · R = 1u' + (total > 1 ? ' · gutter = 3R (counted rest)' : '') +
                ' · one hand: ' + MEDIA[wallMedium].name + ', lean ' + wallSlant.toFixed(2) +
                ' · fatigue κ = ' + params.fatigue.toFixed(2) + '\n' +
                'weather: one field, spine at (' + (spineW.x / wallWn).toFixed(2) + ', ' + (spineW.y / wallHn).toFixed(2) + ')' +
                (hasBlank ? ' · sheet ' + P(blankR, blankC) + ': omitted' : ' · no rested sheet') +
                ' · final line ' + P(lastR, lastC) + ' stops at 0.45\n' +
                'edge-pairs: ' + pairs.length * 2 + ' declared · crossings: ' + crossings.length +
                (crossings.length ? ' — ' + crossings.map(cr => P(cr.r, cr.cL) + '|' + (cr.cL + 2)).join(', ') : '') + '\n' +
                'breaks: ' + (breaksTxt || 'none — the grid held') +
                (pen.on ? '\nink: one ' + (pen.reservoir / 1000).toFixed(2) + ' ml load · '
                    + pen.lineMm.toFixed(2) + ' mm nib · demanded ' + pen.totalM.toFixed(1)
                    + ' m of the ' + penCapM().toFixed(0) + ' m it holds · '
                    + (pen.drySheet < 0
                        ? 'survived, ' + Math.round(100 * pen.left / pen.reservoir) + '% left'
                        : 'RAN DRY at sheet ' + P(Math.floor(pen.drySheet / cols), pen.drySheet % cols)
                          + ', stroke ' + pen.dryMarkN + ' — unsigned, unfinished')
                    : '');
            G.noStroke(); G.fill('#eceadf');
            G.rect(0, WH - scoreBand, WW, scoreBand);
            G.fill(60, 58, 54);
            G.textFont('Courier New');
            G.textSize(Math.round((cols < 3 ? 11 : 13) * scale));
            G.textLeading(Math.round((cols < 3 ? 16 : 19) * scale));
            G.text(wallScoreText, M, WH - scoreBand + 22 * scale, WW - 2 * M, scoreBand - 30 * scale);

            // ---- Restore single-sheet state ----
            Object.assign(params, pSnap);
            Object.assign(state, sSnap);
            state.fieldOffX = 0; state.fieldOffY = 0; state.noiseSeedOverride = null;
            state.bleedL = null; state.bleedR = null;

            if (silent) return { g: G, WW, WH, score: wallScoreText };

            // ---- Adopt as the preview wall; remember how to re-render it ----
            if (wallG) wallG.remove();
            wallG = G;
            wallExport = { cols, rowsW, applySheet, isBlank, isVacant, wallSeed, ASPECT };
            const dispH = Math.round(WH * BASE_W / WW);
            resizeCanvas(BASE_W, dispH);
            background('#d8d3c7');
            image(wallG, 0, 0, BASE_W, dispH);
            scoreDiv.textContent = wallScoreText;
            pen.lastScope = 'wall';
            updateInkUI();
            return { g: G, WW, WH, score: wallScoreText };
        }

        function downloadWallPNG() {
            if (!wallG) return;
            saveCanvas(wallG, 'praktika-wall-' + params.seed, 'png');
        }

        const UHD = 3840;   // 4K long edge

        // Re-execute the whole composition at print density so its long edge
        // reaches 4K, save that one image. Deterministic → identical to the
        // preview, only finer.
        async function downloadWall4K() {
            if (!wallG) return;
            const scoreDiv = document.getElementById('wall-score');
            const keep = wallScoreText;
            const longEdge = Math.max(wallG.width, wallG.height);
            const scale = Math.max(1, UHD / longEdge);
            scoreDiv.textContent = 'Rendering the whole wall at 4K…';
            await new Promise(r => setTimeout(r, 20));
            const buf = await composeWall(scale, true);   // silent: own buffer, no display
            saveCanvas(buf.g, 'praktika-wall-' + params.seed + '-4k', 'png');
            buf.g.remove();
            wallScoreText = keep;
            scoreDiv.textContent = keep;
        }

        // Export every sheet of the current wall as its own 4K image (long
        // edge = 4K). Blank/omitted slots produce no file; a fallen sheet is
        // a real sheet and is exported. One file per sheet, named by slot.
        async function downloadSheets4K() {
            if (!wallExport) return;
            const scoreDiv = document.getElementById('wall-score');
            const keep = wallScoreText;
            const ex = wallExport;
            const sheetH = UHD, sheetW = Math.round(UHD / ex.ASPECT);
            const pSnap = { ...params }, sSnap = { ...state, blobs: [...state.blobs] };
            const todo = [];
            for (let r = 0; r < ex.rowsW; r++) for (let c = 0; c < ex.cols; c++)
                if (!ex.isBlank(r, c)) todo.push([r, c]);
            let n = 0;
            for (const [r, c] of todo) {
                n++;
                scoreDiv.textContent = 'Saving sheet ' + n + ' / ' + todo.length +
                    '  (' + (r + 1) + ',' + (c + 1) + ') at 4K…';
                await new Promise(res => setTimeout(res, 20));
                ex.applySheet(r, c);
                const sg = createGraphics(sheetW, sheetH);
                sg.pixelDensity(1);
                renderTo(sg, sheetW);
                const tag = 'r' + (r + 1) + 'c' + (c + 1);
                saveCanvas(sg, 'praktika-' + ex.wallSeed + '-sheet-' + tag + '-4k', 'png');
                sg.remove();
                await new Promise(res => setTimeout(res, 350));   // let each download settle
            }
            Object.assign(params, pSnap);
            Object.assign(state, sSnap);
            state.fieldOffX = 0; state.fieldOffY = 0; state.noiseSeedOverride = null;
            state.bleedL = null; state.bleedR = null;
            wallScoreText = keep;
            scoreDiv.textContent = todo.length + ' sheets saved at 4K · ' + keep;
        }

        // ── 4K export: re-executes stroke-for-stroke at print density ────────
        function download4K() {
            const W = 4096;
            const g = createGraphics(W, Math.round(W * ASPECT));
            g.pixelDensity(1);
            renderTo(g, W);
            saveCanvas(g, 'ink-ledgers-seed-' + params.seed, 'png');
            g.remove();
        }

        // ── Pen-plotter SVG: one centreline per mark, no fill, no alpha ──────
        function rgbToHex(c) {
            const h = v => Math.round(clampN(v, 0, 255)).toString(16).padStart(2, '0');
            return '#' + h(c[0]) + h(c[1]) + h(c[2]);
        }

        function downloadSVG() {
            const W = 1000, H = Math.round(W * ASPECT);
            const vec = [];
            const g = createGraphics(4, 4); g.pixelDensity(1);
            renderTo(g, W, vec);
            g.remove();

            const wMM = 297, hMM = (297 * ASPECT).toFixed(1);   // ~A3 portrait
            const parts = [];
            parts.push('<?xml version="1.0" encoding="UTF-8"?>');
            parts.push('<svg xmlns="http://www.w3.org/2000/svg" width="' + wMM + 'mm" height="' +
                hMM + 'mm" viewBox="0 0 ' + W + ' ' + H + '">');
            parts.push('<desc>Ink Ledgers — seed ' + params.seed + ', ' + vec.length +
                ' strokes. Single-pen plotter geometry: no fill, no opacity. ' +
                'Tone is carried by mark density. Pick one pen; ignore per-stroke widths if plotting single-colour.</desc>');
            parts.push('<rect width="' + W + '" height="' + H + '" fill="' + state.paper + '"/>');
            // Group strokes by colour so multi-pen setups can split by <g>
            const byCol = {};
            for (const pl of vec) {
                const key = rgbToHex(pl.col);
                (byCol[key] = byCol[key] || []).push(pl);
            }
            for (const key in byCol) {
                parts.push('<g stroke="' + key + '" fill="none" stroke-linecap="round" stroke-linejoin="round">');
                for (const pl of byCol[key]) {
                    const pts = pl.pts.map(p => p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
                    parts.push('<polyline points="' + pts + '" stroke-width="' + pl.w.toFixed(2) + '"/>');
                }
                parts.push('</g>');
            }
            parts.push('</svg>');

            const blob = new Blob([parts.join('\n')], { type: 'image/svg+xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'ink-ledgers-seed-' + params.seed + '-plotter.svg';
            document.body.appendChild(a); a.click(); a.remove();
            URL.revokeObjectURL(url);
        }

        // ── UI ───────────────────────────────────────────────────────────────
        function formatValue(name, v) {
            if (name === 'rowH') return Number(v).toFixed(4);
            return Number(v).toFixed(2);
        }

        function refreshControls() {
            document.getElementById('medium').value = String(params.medium);
            document.getElementById('weightMode').value = String(params.weightMode);
            for (const name of ['rowH', 'density', 'slant', 'tremor', 'ligature', 'composition', 'contrast', 'patchiness', 'band', 'ragged', 'omit', 'partial', 'inkGrain', 'paperTex', 'fatigue']) {
                document.getElementById(name).value = params[name];
                document.getElementById(name + '-value').textContent = formatValue(name, params[name]);
            }
        }

        function updateParam(name, value) {
            params[name] = parseFloat(value);
            document.getElementById(name + '-value').textContent = formatValue(name, value);
            render();
        }

        function updateSelect(name, value) {
            params[name] = parseInt(value);
            render();
        }

        // ── Seed controls ────────────────────────────────────────────────────
        function updateSeedDisplay() {
            document.getElementById('seed-input').value = params.seed;
        }

        function updateSeed() {
            const input = document.getElementById('seed-input');
            const newSeed = parseInt(input.value);
            if (newSeed && newSeed > 0) {
                params.seed = newSeed;
                regenerate();
            } else {
                updateSeedDisplay();
            }
        }

        function previousSeed() {
            params.seed = Math.max(1, params.seed - 1);
            updateSeedDisplay();
            regenerate();
        }

        function nextSeed() {
            params.seed = params.seed + 1;
            updateSeedDisplay();
            regenerate();
        }

        function randomSeedAndUpdate() {
            params.seed = Math.floor(Math.random() * 999999) + 1;
            updateSeedDisplay();
            regenerate();
        }

        function resetParameters() {
            params.seed = 62;
            updateSeedDisplay();
            regenerate();
        }

        window.addEventListener('load', function() {
            updateSeedDisplay();
        });

        // ═══════════════════════════════════════════════════════════════════
        // DMCF RADIO / GALLERY INTEGRATION  (AMEND-023 — the sibling-drawing law)
        //   ?seed=NNNN   render one deterministic sheet at that seed
        //   ?follow=1    reseed live from the radio player's current record.
        //                Ductus is the grammar of the EXHAUSTION FAMILY only —
        //                a process consuming itself to material exhaustion:
        //                SYS-008 (tape-loop/delay) and SYS-010 (testimony).
        //                For those, the pen's one ink load is bound to the
        //                piece's DURATION (the record is given its own length
        //                in ink); where the sheet outdemands the load it runs
        //                dry, unsigned & unfinished. Any other system is NOT
        //                ductus's sibling, so we draw NEUTRAL and say so rather
        //                than fake a homomorphism.
        //   ?wall=1      open straight into the 6x6 wall
        // The engine above is unchanged; this only drives its existing controls.
        // ===================================================================
        (function () {
          // AMEND-023 (operational correction, 2026-08-01): admission to the ductus
          // grammar is PER-RECORD, via the feed flag grammar='ductus' — NOT by SYS code.
          // SYS-008 / SYS-010 airing members are loop-systems (Eno, Fripp) and testimony-
          // collage (Reich), not exhaustion works; gating on them would mis-fire and commit
          // the category error this law forbids. The exhaustion family currently has zero
          // airing members (documented gap) pending the Basinski / Lucier acquisitions.
          function setStatus(t) {
            var el = document.getElementById('dmcf-status');
            if (!el) {
              el = document.createElement('div');
              el.id = 'dmcf-status';
              el.style.cssText = 'position:fixed;left:0;right:0;bottom:0;padding:6px 12px;'
                + 'background:#111;color:#cfcabb;font:11px/1.45 ui-monospace,Menlo,monospace;'
                + 'z-index:9999;white-space:pre-wrap;border-top:1px solid #333';
              document.body.appendChild(el);
            }
            el.textContent = t;
          }
          function overlay(show, html) {
            var el = document.getElementById('dmcf-neutral');
            if (!el) {
              el = document.createElement('div');
              el.id = 'dmcf-neutral';
              el.style.cssText = 'position:fixed;inset:0;display:none;align-items:center;'
                + 'justify-content:center;padding:8%;text-align:center;background:rgba(13,13,16,.93);'
                + 'color:#b7b2a6;font:13px/1.7 ui-serif,Georgia,serif;z-index:9998';
              document.body.appendChild(el);
            }
            el.style.display = show ? 'flex' : 'none';
            if (show && html != null) el.innerHTML = html;
          }
          function esc(x){ return String(x==null?'':x).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
          function pad2(n){ n=String(n); return n.length<2 ? '0'+n : n; }
          function fmtDur(secs){ secs=secs||0; return Math.floor(secs/60)+':'+pad2(secs%60); }
          // ink = duration: 300 s -> ~1.00 ml (engine default), clamped to slider range
          function inkForSecs(secs){ return Math.max(0.2, Math.min(3, (secs||300)/300)); }
          function drawSibling(info){
            window.DUCTUS_DECAY = (info && info.decay) ? info.decay : null;   // AMEND-031: the record's decay curve, or null
            params.seed = (info.seed >>> 0) || 1;
            if (typeof updateSeedDisplay === 'function') updateSeedDisplay();
            if (typeof generate === 'function') generate();
            if (typeof refreshControls === 'function') refreshControls();
            // set the finite pen AFTER refreshControls so nothing overwrites it
            var on = document.getElementById('inkOn'),
                res = document.getElementById('inkReservoir'),
                resV = document.getElementById('inkReservoir-value');
            var ml = inkForSecs(info.secs).toFixed(2);
            if (on) on.checked = true;
            if (res) res.value = ml;
            if (resV) resV.textContent = ml;
            if (typeof syncPen === 'function') syncPen();      // loads pen.* from DOM and renders
            else if (typeof render === 'function') render();
          }
          window.addEventListener('load', function () {
            var q = new URLSearchParams(location.search);
            var s = parseInt(q.get('seed'), 10);
            // When driven as a grammar pop-up (follow/force/anim/wall/?seed), hide the
            // studio chrome and show just the sheet, centred and fitted — so the drawing
            // is the view (like phase/program/score), not the control panel.
            var driven = q.get('follow')==='1' || q.get('force')==='1' || q.get('anim')==='1' || q.get('wall')==='1' || q.get('decayid') || (s>0);
            if (driven) {
              document.body.classList.add('dmcf-embed');
              var st=document.createElement('style');
              st.textContent='body.dmcf-embed .sidebar{display:none!important}'
                +'body.dmcf-embed{display:block!important;background:#0d0e12;margin:0}'
                +'body.dmcf-embed #canvas-container{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:10px;box-sizing:border-box}'
                +'body.dmcf-embed #canvas-container canvas{max-width:97vw!important;max-height:97vh!important;width:auto!important;height:auto!important;border-radius:4px;box-shadow:0 12px 44px rgba(0,0,0,.55)}';
              document.head.appendChild(st);
            }
            if (s && s > 0) { params.seed = s >>> 0; if (typeof updateSeedDisplay === 'function') updateSeedDisplay(); if (typeof regenerate === 'function') regenerate(); }
            // AMEND-031 standalone preview: ?decayid=<recordId> loads that record's decay curve
            // (seed = hash(id)) so a specific Loop's thinning sheet can be inspected without the player.
            var did = q.get('decayid');
            if (did) {
              fetch('airable.json').then(function(r){return r.json();}).then(function(f){
                var rec = (f.tracks||[]).find(function(t){ return t.id===did; });
                if (!rec) return;
                window.DUCTUS_DECAY = rec.decay_curve || null;
                var h=2166136261; for (var i=0;i<did.length;i++){ h^=did.charCodeAt(i); h=Math.imul(h,16777619); }
                params.seed = h>>>0;
                if (typeof updateSeedDisplay === 'function') updateSeedDisplay();
                if (typeof regenerate === 'function') regenerate();
              }).catch(function(){});
            }
            if (q.get('wall') === '1' && typeof composeWall === 'function') { try { composeWall(); } catch (e) {} }
            if (q.get('follow') === '1') {
              document.title = 'DMCF Radio — live ductus';
              var FORCE = q.get('force') === '1';
              var last = null;
              (function tick() {
                try {
                  if (!window.opener || window.opener.closed || !window.opener.DMCFArt) {
                    overlay(false);
                    setStatus('Player window closed — open DMCF-Radio-page.html and press Ductus.');
                  } else {
                    var info = window.opener.DMCFArt.now();
                    if (info && info.id !== last) {
                      last = info.id;
                      if (info.grammar === 'ductus' || FORCE) {
                        overlay(false);
                        drawSibling(info);
                        setStatus((info.title || '') + '  —  ' + (info.credit || '') + '\n'
                          + info.id + '  ·  ' + info.system + (info.sysName ? ' ' + info.sysName : '')
                          + '  ·  ' + fmtDur(info.secs)
                          + '  ·  ink = duration → ' + inkForSecs(info.secs).toFixed(2) + ' ml'
                          + '  ·  seed = hash(id) = ' + (info.seed >>> 0)
                          + ((FORCE && info.grammar !== 'ductus') ? '\n[STUDY OVERRIDE — not an admitted record; ductus shown for verification only]' : ''));
                      } else {
                        overlay(true,
                          '<div><div style="font-size:15px;color:#e7e2d6;margin-bottom:10px">Not admitted to the ductus grammar</div>'
                          + '<div style="max-width:34em">Ductus is the grammar of the <b>exhaustion family</b> — a process consuming itself to material exhaustion. '
                          + 'Per <b>AMEND-023</b>, a record draws ductus only when admitted per-record (feed flag grammar=&#39;ductus&#39;), never by system code. '
                          + 'No record is admitted yet: the family&#39;s exemplars (Basinski, <i>The Disintegration Loops</i>; Lucier, <i>I Am Sitting in a Room</i>) are '
                          + '<b>acquisition-pending</b>. ' + esc(info.id) + ' (' + esc(info.system) + (info.sysName ? ' ' + esc(info.sysName) : '')
                          + ') draws <b>neutral</b> — its canon drawing is on <b>Canon art ↗</b>.</div></div>');
                        setStatus(esc(info.id) + '  ·  ' + esc(info.system) + '  —  neutral (not admitted to ductus)');
                      }
                    }
                  }
                } catch (e) {}
                setTimeout(tick, 1000);
              })();
            }
          });
        })();
    </script>
